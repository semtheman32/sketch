,"order":1,"stereo":"none"},"b6":{"id":"b6","a1":"a7","a2":"a8","order":1,"stereo":"none"},"b7":{"id":"b7","a1":"a8","a2":"a9","order":1,"stereo":"none"},"b8":{"id":"b8","a1":"a10","a2":"a11","order":1,"stereo":"none"},"b9":{"id":"b9","a1":"a11","a2":"a12","order":1,"stereo":"none"},"b10":{"id":"b10","a1":"a12","a2":"a13","order":1,"stereo":"none"},"b11":{"id":"b11","a1":"a13","a2":"a14","order":1,"stereo":"none"},"b12":{"id":"b12","a1":"a14","a2":"a15","order":1,"stereo":"none"},"b13":{"id":"b13","a1":"a15","a2":"a16","order":1,"stereo":"none"},"b14":{"id":"b14","a1":"a15","a2":"a17","order":2,"stereo":"none"}},"arrows":{"r1":{"id":"r1","kind":"equilibrium","x1":330.91,"y1":939.17,"x2":440.91,"y2":939.17,"above":"H⁺ (kat.)","below":"in tolueen"}},"curlies":{},"texts":{"t1":{"id":"t1","x":0,"y":0,"text":"Les 16 · Ontmengende vloeistoffen, stoomdestillatie en waterafscheiding","bold":true,"size":24},"t2":{"id":"t2","x":0,"y":30,"text":"Scheidingstechnieken. Lesstof uit het lesoverzicht: tekeningen met uitleg per hoofdstuk.","size":13,"italic":true,"color":"#6b7280"},"t3":{"id":"t3","x":0,"y":74,"text":"1. Ontmengende vloeistoffen","bold":true,"size":19,"color":"#1d4ed8"},"t4":{"id":"t4","x":0,"y":102,"text":"Niet alle vloeistoffen mengen. Water en fenol vormen bij kamertemperatuur twee lagen. Hoe ziet het","size":13,"italic":true},"t5":{"id":"t5","x":0,"y":121,"text":"fasediagram eruit, en wat betekent dat voor extractie en drogen op het lab?","size":13,"italic":true},"t6":{"id":"t6","x":0,"y":150,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t7":{"id":"t7","x":0,"y":169,"text":"• Onder de koepel: twee lagen, elk verzadigd aan de andere stof.","size":13,"color":"#047857"},"t8":{"id":"t8","x":0,"y":188,"text":"• Wederzijdse oplosbaarheid stijgt met T. Ijs geeft betere ontmenging.","size":13,"color":"#047857"},"t9":{"id":"t9","x":0,"y":207,"text":"• Natte organische laag drogen met een droogmiddel (MgSO₄, CaCl₂).","size":13,"color":"#047857"},"t10":{"id":"t10","x":0,"y":268,"text":"2. De heterogene azeotroop","bold":true,"size":19,"color":"#1d4ed8"},"t11":{"id":"t11","x":0,"y":296,"text":"Wat gebeurt er als je een mengsel van twee slecht mengende vloeistoffen gaat koken? Vaak kookt het","size":13,"italic":true},"t12":{"id":"t12","x":0,"y":315,"text":"voordat de lagen kunnen mengen. Dan smelten het ontmenggebied en een minimum azeotroop samen tot een","size":13,"italic":true},"t13":{"id":"t13","x":0,"y":334,"text":"heterogene azeotroop.","size":13,"italic":true},"t14":{"id":"t14","x":0,"y":363,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t15":{"id":"t15","x":0,"y":382,"text":"• Heterogene azeotroop = ontmenggebied + minimum azeotroop.","size":13,"color":"#047857"},"t16":{"id":"t16","x":0,"y":401,"text":"• Kookt onder beide kookpunten; de damp ontmengt bij condensatie.","size":13,"color":"#047857"},"t17":{"id":"t17","x":0,"y":420,"text":"• Twee lagen in de kolf: direct azeotropische damp, geen extra schotels nodig.","size":13,"color":"#047857"},"t18":{"id":"t18","x":0,"y":481,"text":"3. Stoomdestillatie","bold":true,"size":19,"color":"#1d4ed8"},"t19":{"id":"t19","x":0,"y":509,"text":"Hoe krijg je een stof met een hoog kookpunt, of een stof die ontleedt bij verhitten, toch in de damp? Met","size":13,"italic":true},"t20":{"id":"t20","x":0,"y":528,"text":"stoom. Water levert het grootste deel van de dampdruk, en de stof gaat mee onder 100 °C.","size":13,"italic":true},"t21":{"id":"t21","x":0,"y":557,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t22":{"id":"t22","x":0,"y":576,"text":"• Kookt als pwater + pstof = pₒmgeving, dus onder 100 °C.","size":13,"color":"#047857"},"t23":{"id":"t23","x":0,"y":595,"text":"• Voorwaarden: niet watergevoelig, heterogene azeotroop met water, dampdruk ≥ ~0,1 × water bij 100 °C.","size":13,"color":"#047857"},"t24":{"id":"t24","x":0,"y":614,"text":"• Destillaat = twee lagen: scheitrechter, eventueel ijs, drogen.","size":13,"color":"#047857"},"t25":{"id":"t25","x":0,"y":675,"text":"4. Waterafscheiding met een Dean-Stark-opzet","bold":true,"size":19,"color":"#1d4ed8"},"t26":{"id":"t26","x":0,"y":703,"text":"Bij een verestering ontstaat water, en het evenwicht ligt vaak links. Als je het water steeds wegvangt,","size":13,"italic":true},"t27":{"id":"t27","x":0,"y":722,"text":"loopt de reactie naar rechts. Dat doe je met een oplosmiddel dat een heterogene azeotroop met water","size":13,"italic":true},"t28":{"id":"t28","x":0,"y":741,"text":"vormt.","size":13,"italic":true},"t29":{"id":"t29","x":0,"y":770,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t30":{"id":"t30","x":0,"y":789,"text":"• Water wegvangen = evenwicht naar rechts (Le Chatelier).","size":13,"color":"#047857"},"t31":{"id":"t31","x":0,"y":808,"text":"• Damp = heterogene azeotroop van water en oplosmiddel; condensaat ontmengt.","size":13,"color":"#047857"},"t32":{"id":"t32","x":0,"y":827,"text":"• Oplosmiddel terug in de kolf, water blijft in de buis. Volume water = maat voor de conversie.","size":13,"color":"#047857"},"t33":{"id":"t33","x":0,"y":862,"text":"Verestering met waterafscheiding . Voorbeeld: azijnzuur + 1-butanol ⇌ butylacetaat + water","size":13,"bold":false},"t34":{"id":"t34","text":"azijnzuur","x":43.86,"y":1003.22,"color":"#555555","italic":true,"size":12},"t35":{"id":"t35","text":"+","x":132.31,"y":945.17,"size":18},"t36":{"id":"t36","text":"1-butanol","x":182.81,"y":983.22,"color":"#555555","italic":true,"size":12},"t37":{"id":"t37","text":"butylacetaat","x":536.41,"y":1009.32,"color":"#555555","italic":true,"size":12},"t38":{"id":"t38","text":"+","x":703.71,"y":945.17,"size":18},"t39":{"id":"t39","text":"water","x":747.71,"y":973.17,"color":"#555555","italic":true,"size":12},"t40":{"id":"t40","x":0,"y":1046.1,"text":"Waarom: Het evenwicht ligt links. Door het water steeds uit het reactiemengsel te halen, kan het niet","size":13,"italic":true,"color":"#6b7280"},"t41":{"id":"t41","x":0,"y":1065.1,"text":"terugreageren. De reactie loopt dan door naar de ester. Het oplosmiddel neemt het water mee omdat de","size":13,"italic":true,"color":"#6b7280"},"t42":{"id":"t42","x":0,"y":1084.1,"text":"azeotroop het laagst kookt. Na condensatie ontmengen water en tolueen, zodat je ze makkelijk scheidt. De","size":13,"italic":true,"color":"#6b7280"},"t43":{"id":"t43","x":0,"y":1103.1,"text":"voorbeeldstoffen zijn ; dia 13 gebruikt R1-COOH + R2-OH.","size":13,"italic":true,"color":"#6b7280"}},"brackets":{}}