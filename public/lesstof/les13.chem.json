,"order":2,"stereo":"none"},"b28":{"id":"b28","a1":"a28","a2":"a30","order":1,"stereo":"none"},"b29":{"id":"b29","a1":"a30","a2":"a31","order":2,"stereo":"none"},"b30":{"id":"b30","a1":"a31","a2":"a32","order":1,"stereo":"none"},"b31":{"id":"b31","a1":"a32","a2":"a33","order":2,"stereo":"none"},"b32":{"id":"b32","a1":"a33","a2":"a34","order":1,"stereo":"none"},"b33":{"id":"b33","a1":"a34","a2":"a35","order":2,"stereo":"none"},"b34":{"id":"b34","a1":"a35","a2":"a30","order":1,"stereo":"none"},"b35":{"id":"b35","a1":"a36","a2":"a37","order":1,"stereo":"none"},"b36":{"id":"b36","a1":"a37","a2":"a38","order":1,"stereo":"none"},"b37":{"id":"b37","a1":"a37","a2":"a39","order":1,"stereo":"none"},"b38":{"id":"b38","a1":"a37","a2":"a40","order":1,"stereo":"none"},"b39":{"id":"b39","a1":"a40","a2":"a41","order":1,"stereo":"none"},"b40":{"id":"b40","a1":"a41","a2":"a42","order":1,"stereo":"none"},"b41":{"id":"b41","a1":"a41","a2":"a43","order":1,"stereo":"none"},"b42":{"id":"b42","a1":"a41","a2":"a44","order":1,"stereo":"none"}},"arrows":{},"curlies":{},"texts":{"t1":{"id":"t1","x":0,"y":0,"text":"Les 13 · Herkristallisatie en smeltpunt","bold":true,"size":24},"t2":{"id":"t2","x":0,"y":30,"text":"Scheidingstechnieken. Lesstof uit het lesoverzicht: tekeningen met uitleg per hoofdstuk.","size":13,"italic":true,"color":"#6b7280"},"t3":{"id":"t3","x":0,"y":74,"text":"1. Het driehoeksdiagram","bold":true,"size":19,"color":"#1d4ed8"},"t4":{"id":"t4","x":0,"y":102,"text":"Bij herkristallisatie spelen drie stoffen mee: je product, de verontreiniging en het oplosmiddel. Een","size":13,"italic":true},"t5":{"id":"t5","x":0,"y":121,"text":"driehoeksdiagram laat zien wanneer alles opgelost is en wanneer iets uitkristalliseert. Met dat diagram","size":13,"italic":true},"t6":{"id":"t6","x":0,"y":140,"text":"snap je elke stap van de herkristallisatie.","size":13,"italic":true},"t7":{"id":"t7","x":0,"y":169,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t8":{"id":"t8","x":0,"y":188,"text":"• Hoekpunten: product, verontreiniging, oplosmiddel.","size":13,"color":"#047857"},"t9":{"id":"t9","x":0,"y":207,"text":"• Je wilt in het gebied linksonder eindigen: alleen zuiver product kristalliseert.","size":13,"color":"#047857"},"t10":{"id":"t10","x":0,"y":226,"text":"• Oplosmiddel toevoegen = een rechte lijn naar het bovenste hoekpunt.","size":13,"color":"#047857"},"t11":{"id":"t11","x":0,"y":287,"text":"2. Oplossen, afkoelen, uitkristalliseren","bold":true,"size":19,"color":"#1d4ed8"},"t12":{"id":"t12","x":0,"y":315,"text":"Hoe verloopt een herkristallisatie stap voor stap, en wat gebeurt er in het diagram bij elke stap? Waarom","size":13,"italic":true},"t13":{"id":"t13","x":0,"y":334,"text":"gebruik je precies genoeg heet oplosmiddel, en waarom blijft er altijd product achter in de oplossing?","size":13,"italic":true},"t14":{"id":"t14","x":0,"y":363,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t15":{"id":"t15","x":0,"y":382,"text":"• Gebruik precies genoeg heet oplosmiddel. Meer oplosmiddel betekent minder opbrengst.","size":13,"color":"#047857"},"t16":{"id":"t16","x":0,"y":401,"text":"• De moederloog blijft verzadigd aan product: de opbrengst is nooit 100 %.","size":13,"color":"#047857"},"t17":{"id":"t17","x":0,"y":420,"text":"• Herkristallisatie is voor het eindproduct: kwaliteit boven kwantiteit.","size":13,"color":"#047857"},"t18":{"id":"t18","x":0,"y":481,"text":"3. Als het misgaat: geen kristallen of een olie","bold":true,"size":19,"color":"#1d4ed8"},"t19":{"id":"t19","x":0,"y":509,"text":"Soms komt er niets uit de oplossing, ook al is die oververzadigd. En soms komt er een olie in plaats van","size":13,"italic":true},"t20":{"id":"t20","x":0,"y":528,"text":"kristallen. Hoe komt dat, en wat doe je eraan?","size":13,"italic":true},"t21":{"id":"t21","x":0,"y":557,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t22":{"id":"t22","x":0,"y":576,"text":"• Geen kristallen? Krassen, entkristal, indampen, of een ander oplosmiddel.","size":13,"color":"#047857"},"t23":{"id":"t23","x":0,"y":595,"text":"• Oiling out: oververzadiging boven het smeltpunt van het product.","size":13,"color":"#047857"},"t24":{"id":"t24","x":0,"y":614,"text":"• Meer oplosmiddel verlaagt die temperatuur, maar kost opbrengst.","size":13,"color":"#047857"},"t25":{"id":"t25","x":0,"y":675,"text":"4. Smeltpunt en zuiverheid","bold":true,"size":19,"color":"#1d4ed8"},"t26":{"id":"t26","x":0,"y":703,"text":"Hoe weet je of je kristallen zuiver zijn? Een smeltpuntsbepaling geeft snel een idee. Een verontreiniging","size":13,"italic":true},"t27":{"id":"t27","x":0,"y":722,"text":"verlaagt het smeltpunt en maakt het smelttraject breder.","size":13,"italic":true},"t28":{"id":"t28","x":0,"y":751,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t29":{"id":"t29","x":0,"y":770,"text":"• Onzuiver = lager smeltpunt en breder traject.","size":13,"color":"#047857"},"t30":{"id":"t30","x":0,"y":789,"text":"• Vuistregel: 1 mol% ≈ 0,5 °C lager.","size":13,"color":"#047857"},"t31":{"id":"t31","x":0,"y":808,"text":"• De druk hoef je bij een smeltpunt niet te noteren: de smeltlijn loopt steil.","size":13,"color":"#047857"},"t32":{"id":"t32","x":0,"y":869,"text":"5. Structuuropheldering (opdracht les 13)","bold":true,"size":19,"color":"#1d4ed8"},"t33":{"id":"t33","x":0,"y":897,"text":"Bij deze les hoort een oefenopdracht structuuropheldering: vier stoffen met MS, IR, ¹H- en ¹³C-NMR. Hier","size":13,"italic":true},"t34":{"id":"t34","x":0,"y":916,"text":"staat per stof kort de redenering. De spectrumtabellen staan op het formuleblad.","size":13,"italic":true},"t35":{"id":"t35","x":0,"y":945,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t36":{"id":"t36","x":0,"y":964,"text":"• M⁺ en het isotooppatroon eerst: dat geeft de formule en het aantal Cl.","size":13,"color":"#047857"},"t37":{"id":"t37","x":0,"y":983,"text":"• Signaal rond 4 ppm in ¹H en 60 tot 65 ppm in ¹³C: CH₂ aan O.","size":13,"color":"#047857"},"t38":{"id":"t38","x":0,"y":1002,"text":"• Elk signaal moet een plek in je structuur hebben.","size":13,"color":"#047857"},"t39":{"id":"t39","x":0,"y":1037,"text":"Vraag 1: butylacetaat. butylacetaat, C₆H₁₂O₂ (M = 116)","size":13,"bold":false},"t40":{"id":"t40","text":".","x":24,"y":1076,"color":"#ffffff","size":6},"t41":{"id":"t41","text":".","x":281.8,"y":1186.3,"color":"#ffffff","size":6},"t42":{"id":"t42","x":0,"y":1232.7,"text":"Stof 2: 5 aromatische H, dus een monogesubstitueerde benzeenring. Twee tripletten van 2H: –CH₂–CH₂–. Het","size":13,"bold":false},"t43":{"id":"t43","x":0,"y":1251.7,"text":"CH₂ op 3,66 ppm zit aan een elektronegatief atoom. MS: M⁺ 140 en 142 (3 : 1), dus één Cl. Piek 91 is het","size":13,"bold":false},"t44":{"id":"t44","x":0,"y":1270.7,"text":"benzylkation C₇H₇⁺ .","size":13,"bold":false},"t45":{"id":"t45","text":".","x":24,"y":1309.7,"color":"#ffffff","size":6},"t46":{"id":"t46","text":".","x":247.1,"y":1440.2,"color":"#ffffff","size":6},"t47":{"id":"t47","x":0,"y":1486.6,"text":"Stof 3: CH₃ op 2,37 ppm aan een ring (21 ppm in ¹³C). Drie aromatische H naast elkaar: d, t, d. Zes","size":13,"bold":false},"t48":{"id":"t48","x":0,"y":1505.6,"text":"verschillende ring-C. MS: M⁺ 160, 162, 164 (9 : 6 : 1), dus twee Cl. Zo komen de Cl op 2 en 3 naast de","size":13,"bold":false},"t49":{"id":"t49","x":0,"y":1524.6,"text":"methylgroep.","size":13,"bold":false},"t50":{"id":"t50","text":".","x":24,"y":1563.6,"color":"#ffffff","size":6},"t51":{"id":"t51","text":".","x":212.5,"y":1733.6,"color":"#ffffff","size":6},"t52":{"id":"t52","x":0,"y":1780,"text":"Stof 4: H op 12,09 ppm en C op 173 ppm: een carbonzuur. Vijf aromatische H (2 + 3): monogesubstitueerde","size":13,"bold":false},"t53":{"id":"t53","x":0,"y":1799,"text":"ring. MS: M⁺ 122, en 105 (verlies van OH) en 77 (C₆H₅⁺).","size":13,"bold":false},"t54":{"id":"t54","text":".","x":24,"y":1838,"color":"#ffffff","size":6},"t55":{"id":"t55","text":".","x":143.5,"y":2028.1,"color":"#ffffff","size":6},"t56":{"id":"t56","x":0,"y":2074.5,"text":"Zet het in elkaar: (CH₃)₃C–CH₂–C(CH₃)₂–OH.","size":13,"bold":false},"t57":{"id":"t57","text":".","x":24,"y":2113.5,"color":"#ffffff","size":6},"t58":{"id":"t58","text":".","x":212.6,"y":2218.3,"color":"#ffffff","size":6}},"brackets":{}}