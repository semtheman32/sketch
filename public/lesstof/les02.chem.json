":"a66","order":1,"stereo":"none"}},"arrows":{},"curlies":{},"texts":{"t1":{"id":"t1","x":22,"y":48,"text":"¹H-NMR: verschuiving, integraal en opsplitsing","bold":true,"size":24},"t2":{"id":"t2","x":22,"y":78,"text":"Structuuropheldering. Alle tekeningen uit het lesoverzicht, met de uitleg per hoofdstuk.","size":13,"italic":true,"color":"#6b7280"},"t3":{"id":"t3","x":0,"y":142,"text":"1. Wat meet ¹H-NMR?","bold":true,"size":21,"color":"#3b6fd4"},"t4":{"id":"t4","x":22,"y":210,"text":"Na een synthese wil je weten of je de goede stof hebt gemaakt. ¹H-NMR laat zien welke soorten H-atomen er","size":13.5,"italic":true},"t5":{"id":"t5","x":22,"y":229,"text":"in een molecuul zitten en hoe ze aan elkaar vastzitten. Hoe werkt dat meten, en wat betekent de","size":13.5,"italic":true},"t6":{"id":"t6","x":22,"y":248,"text":"ppm-schaal?","size":13.5,"italic":true},"t7":{"id":"t7","x":22,"y":330,"text":"• ¹H-NMR meet de energie om de spin van een H-kern om te klappen.","size":13.5},"t8":{"id":"t8","x":22,"y":349,"text":"• TMS ligt bij 0 ppm.","size":13.5},"t9":{"id":"t9","x":22,"y":368,"text":"• δ (ppm) = afstand tot TMS (Hz) / spectrometerfrequentie (MHz).","size":13.5},"t10":{"id":"t10","x":0,"y":442,"text":"2. De chemische verschuiving","bold":true,"size":21,"color":"#3b6fd4"},"t11":{"id":"t11","x":22,"y":510,"text":"Waarom liggen niet alle H-atomen op dezelfde plek? Elk H voelt een iets ander magneetveld, door de","size":13.5,"italic":true},"t12":{"id":"t12","x":22,"y":529,"text":"elektronen eromheen. Zo kun je aan de plek van een signaal zien naast welke groep een H zit.","size":13.5,"italic":true},"t13":{"id":"t13","x":22,"y":611,"text":"• Weinig elektronen rond het H (naast O, N, Cl, C=O): links, hoge δ.","size":13.5},"t14":{"id":"t14","x":22,"y":630,"text":"• Veel elektronen (gewone alkylgroep): rechts, lage δ.","size":13.5},"t15":{"id":"t15","x":22,"y":649,"text":"• Aromatisch 6,5 tot 8; vinylisch 4,5 tot 6; aldehyde 9 tot 10; carbonzuur 10 tot 12 ppm.","size":13.5},"t16":{"id":"t16","x":0,"y":723,"text":"3. Gelijkwaardige protonen en de integraal","bold":true,"size":21,"color":"#3b6fd4"},"t17":{"id":"t17","x":22,"y":791,"text":"Hoeveel signalen zie je, en hoeveel H zit er in elk signaal? H-atomen met precies dezelfde omgeving geven","size":13.5,"italic":true},"t18":{"id":"t18","x":22,"y":810,"text":"samen één signaal. De oppervlakte van dat signaal vertelt hoeveel H het zijn.","size":13.5,"italic":true},"t19":{"id":"t19","x":22,"y":892,"text":"• Aantal signalen = aantal sets gelijkwaardige H.","size":13.5},"t20":{"id":"t20","x":22,"y":911,"text":"• Integraal = verhouding van het aantal H per signaal.","size":13.5},"t21":{"id":"t21","x":22,"y":930,"text":"• Twee H op hetzelfde C kunnen toch verschillen (cis/trans, dia 13).","size":13.5},"t22":{"id":"t22","x":22,"y":996,"text":"Hoeveel signalen? (dia 12). gelijke letters = gelijkwaardige H","size":14,"bold":true},"t23":{"id":"t23","text":"a","x":40.95,"y":1096.39,"color":"#d64545","bold":true,"size":13},"t24":{"id":"t24","text":"a","x":151.85,"y":1096.86,"color":"#d64545","bold":true,"size":13},"t25":{"id":"t25","text":"methoxymethaan","x":56.6,"y":1128,"color":"#555555","italic":true,"size":12},"t26":{"id":"t26","text":"a","x":321.88,"y":1096.71,"color":"#d64545","bold":true,"size":13},"t27":{"id":"t27","text":"b","x":266.5,"y":1040.7,"color":"#d64545","bold":true,"size":13},"t28":{"id":"t28","text":"chloorethaan","x":232.8,"y":1128,"color":"#555555","italic":true,"size":12},"t29":{"id":"t29","text":"a","x":509.29,"y":1056.02,"color":"#d64545","bold":true,"size":13},"t30":{"id":"t30","text":"b","x":419.26,"y":1044,"color":"#d64545","bold":true,"size":13},"t31":{"id":"t31","text":"c","x":363.71,"y":1099.98,"color":"#d64545","bold":true,"size":13},"t32":{"id":"t32","text":"methoxyethaan","x":389.7,"y":1128,"color":"#555555","italic":true,"size":12},"t33":{"id":"t33","text":".","x":30,"y":1023,"color":"#ffffff","size":6},"t34":{"id":"t34","text":".","x":510,"y":1138,"color":"#ffffff","size":6},"t35":{"id":"t35","x":22,"y":1168.4,"text":"Waarom: Het apparaat \"ziet\" alleen de omgeving van een H. Twee CH₃-groepen die allebei aan dezelfde O","size":13,"italic":true,"color":"#6b7280"},"t36":{"id":"t36","x":22,"y":1187.4,"text":"zitten, zijn niet van elkaar te onderscheiden. In methoxyethaan zit de ene CH₃ aan O en de andere aan","size":13,"italic":true,"color":"#6b7280"},"t37":{"id":"t37","x":22,"y":1206.4,"text":"CH₂: andere omgeving, ander signaal.","size":13,"italic":true,"color":"#6b7280"},"t38":{"id":"t38","x":0,"y":1280.4,"text":"4. Opsplitsing: de n+1-regel","bold":true,"size":21,"color":"#3b6fd4"},"t39":{"id":"t39","x":22,"y":1348.4,"text":"Een signaal is vaak niet één piek, maar een groepje. Dat komt door de H-atomen op het C ernaast. Aan het","size":13.5,"italic":true},"t40":{"id":"t40","x":22,"y":1367.4,"text":"aantal pieken zie je dus hoeveel buren een H heeft. Dat is de sleutel om stukjes molecuul aan elkaar te","size":13.5,"italic":true},"t41":{"id":"t41","x":22,"y":1386.4,"text":"knopen.","size":13.5,"italic":true},"t42":{"id":"t42","x":22,"y":1468.4,"text":"• n gelijkwaardige buren (3 bindingen ver): n + 1 pieken.","size":13.5},"t43":{"id":"t43","x":22,"y":1487.4,"text":"• Hoogtes: doublet 1:1, triplet 1:2:1, quartet 1:3:3:1, quintet 1:4:6:4:1.","size":13.5},"t44":{"id":"t44","x":22,"y":1506.4,"text":"• Niet splitsen: H’s onderling gelijk, OH/NH, en H’s verder dan 3 bindingen.","size":13.5},"t45":{"id":"t45","x":22,"y":1572.4,"text":"Van aantal buren naar signaal (dia 24). 1-broom-3-methylbutaan (dia 18): a doublet, b 8 + 1 = 9 pieken, c","size":14,"bold":true},"t46":{"id":"t46","x":22,"y":1591.4,"text":"quartet, d triplet","size":14,"bold":true},"t47":{"id":"t47","text":"a","x":225.78,"y":1733.41,"color":"#d64545","bold":true,"size":13},"t48":{"id":"t48","text":"a","x":170.24,"y":1637.4,"color":"#d64545","bold":true,"size":13},"t49":{"id":"t49","text":"b","x":191.87,"y":1690.67,"color":"#d64545","bold":true,"size":13},"t50":{"id":"t50","text":"c","x":135.64,"y":1745.5,"color":"#d64545","bold":true,"size":13},"t51":{"id":"t51","text":"d","x":101.1,"y":1677.5,"color":"#d64545","bold":true,"size":13},"t52":{"id":"t52","text":".","x":30,"y":1618.4,"color":"#ffffff","size":6},"t53":{"id":"t53","text":".","x":248.5,"y":1774.5,"color":"#ffffff","size":6},"t54":{"id":"t54","text":"1-broom-3-methylbutaan","x":71.05,"y":1800.5,"color":"#555555","italic":true,"size":12},"t55":{"id":"t55","x":22,"y":1833.3,"text":"Waarom: Elke buur-H staat met het veld mee of ertegenin, met even veel kans. Bij n buren tel je hoeveel","size":13,"italic":true,"color":"#6b7280"},"t56":{"id":"t56","x":22,"y":1852.3,"text":"combinaties dezelfde totale bijdrage geven. Dat aantal is een getal uit de driehoek van Pascal.","size":13,"italic":true,"color":"#6b7280"},"t57":{"id":"t57","x":22,"y":1871.3,"text":"Combinaties met dezelfde bijdrage vallen op één piek, dus die piek wordt hoger. In 1-broom-3-methylbutaan","size":13,"italic":true,"color":"#6b7280"},"t58":{"id":"t58","x":22,"y":1890.3,"text":"heeft het CH (b) 6 + 2 = 8 buren: 9 pieken, als de J’s gelijk zijn (dia 18).","size":13,"italic":true,"color":"#6b7280"},"t59":{"id":"t59","x":22,"y":1956.3,"text":"Isopropylbutanoaat (dia 21)","size":14,"bold":true},"t60":{"id":"t60","text":"a","x":45.72,"y":2098.41,"color":"#d64545","bold":true,"size":13},"t61":{"id":"t61","text":"c","x":101.04,"y":2042.4,"color":"#d64545","bold":true,"size":13},"t62":{"id":"t62","text":"d","x":135.86,"y":2110.3,"color":"#d64545","bold":true,"size":13},"t63":{"id":"t63","text":"e","x":239.7,"y":2090.3,"color":"#d64545","bold":true,"size":13},"t64":{"id":"t64","text":"b","x":295.1,"y":2098.17,"color":"#d64545","bold":true,"size":13},"t65":{"id":"t65","text":"b","x":239.7,"y":2002.3,"color":"#d64545","bold":true,"size":13},"t66":{"id":"t66","text":".","x":30,"y":1983.3,"color":"#ffffff","size":6},"t67":{"id":"t67","text":".","x":317.8,"y":2139.4,"color":"#ffffff","size":6},"t68":{"id":"t68","text":"isopropylbutanoaat","x":118.1,"y":2141.4,"color":"#555555","italic":true,"size":12},"t69":{"id":"t69","x":0,"y":2225.2,"text":"5. De koppelingsconstante J","bold":true,"size":21,"color":"#3b6fd4"},"t70":{"id":"t70","x":22,"y":2293.2,"text":"De afstand tussen de pieken van een opgesplitst signaal heet de koppelingsconstante J. Waarom is die","size":13.5,"italic":true},"t71":{"id":"t71","x":22,"y":2312.2,"text":"nuttig? Twee H’s die elkaar splitsen hebben dezelfde J. En als een H twee soorten buren heeft met een","size":13.5,"italic":true},"t72":{"id":"t72","x":22,"y":2331.2,"text":"andere J, verandert de vorm van het signaal.","size":13.5,"italic":true},"t73":{"id":"t73","x":22,"y":2413.2,"text":"• J = afstand tussen twee pieken, in Hz; partners hebben dezelfde J.","size":13.5},"t74":{"id":"t74","x":22,"y":2432.2,"text":"• Richtwaarden: sp³–sp³ ≈ 7, trans ≈ 15, cis ≈ 10, geminaal =CH₂ ≈ 2 Hz.","size":13.5},"t75":{"id":"t75","x":22,"y":2451.2,"text":"• Twee buren met verschillende J: doublet van doublets (1:1:1:1).","size":13.5},"t76":{"id":"t76","x":22,"y":2517.2,"text":"Cis- en trans-koppeling (dia 32). 3-chloorpropeenzuur: H a en H b in trans (links) en cis (rechts)","size":14,"bold":true},"t77":{"id":"t77","text":"a","x":148.3,"y":2686.9,"color":"#d64545","bold":true,"size":12},"t78":{"id":"t78","text":"b","x":113.5,"y":2586.9,"color":"#d64545","bold":true,"size":12},"t79":{"id":"t79","text":"a","x":466.1,"y":2673.3,"color":"#d64545","bold":true,"size":12},"t80":{"id":"t80","text":"b","x":397,"y":2713.6,"color":"#d64545","bold":true,"size":12},"t81":{"id":"t81","text":"trans: H’s aan weerszijden","x":115,"y":2757.6,"color":"#555555","italic":true,"size":12},"t82":{"id":"t82","text":"J ≈ 14 Hz","x":110,"y":2779.6,"bold":true,"size":13},"t83":{"id":"t83","text":"cis: H’s aan dezelfde kant","x":330,"y":2757.6,"color":"#555555","italic":true,"size":12},"t84":{"id":"t84","text":"J ≈ 9 Hz","x":370,"y":2779.6,"bold":true,"size":13},"t85":{"id":"t85","text":".","x":30,"y":2