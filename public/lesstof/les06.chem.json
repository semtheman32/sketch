60","order":1,"stereo":"none"},"b55":{"id":"b55","a1":"a60","a2":"a55","order":1,"stereo":"none"},"b56":{"id":"b56","a1":"a61","a2":"a62","order":1,"stereo":"none"},"b57":{"id":"b57","a1":"a62","a2":"a63","order":1,"stereo":"none"},"b58":{"id":"b58","a1":"a63","a2":"a64","order":1,"stereo":"none"},"b59":{"id":"b59","a1":"a63","a2":"a65","order":1,"stereo":"none"},"b60":{"id":"b60","a1":"a65","a2":"a66","order":1,"stereo":"none"},"b61":{"id":"b61","a1":"a66","a2":"a67","order":1,"stereo":"none"}},"arrows":{},"curlies":{},"texts":{"t1":{"id":"t1","x":0,"y":0,"text":"Les 6 · Vacuüm- en eenvoudige destillatie","bold":true,"size":24},"t2":{"id":"t2","x":0,"y":30,"text":"Scheidingstechnieken. Lesstof uit het lesoverzicht: tekeningen met uitleg per hoofdstuk.","size":13,"italic":true,"color":"#6b7280"},"t3":{"id":"t3","x":0,"y":74,"text":"1. Verdampen en koken: het p,T-diagram","bold":true,"size":19,"color":"#1d4ed8"},"t4":{"id":"t4","x":0,"y":102,"text":"Een vloeistof verdampt al lang voordat hij kookt. Wanneer kookt hij dan precies? En waarom kookt hij","size":13,"italic":true},"t5":{"id":"t5","x":0,"y":121,"text":"lager als je de druk verlaagt? Het p,T-diagram van een zuivere stof geeft het antwoord.","size":13,"italic":true},"t6":{"id":"t6","x":0,"y":150,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t7":{"id":"t7","x":0,"y":169,"text":"• Een vloeistof kookt als verzadigde dampspanning = omgevingsdruk.","size":13,"color":"#047857"},"t8":{"id":"t8","x":0,"y":188,"text":"• Onder het kookpunt verdampt een vloeistof wel; hij kookt alleen niet.","size":13,"color":"#047857"},"t9":{"id":"t9","x":0,"y":207,"text":"• Lagere omgevingsdruk betekent een lager kookpunt.","size":13,"color":"#047857"},"t10":{"id":"t10","x":0,"y":242,"text":"Refluxkoeler bij 5 °C (Lavendel vraag 20)","size":13,"bold":false},"t11":{"id":"t11","text":"dichloormethaan","x":26.11,"y":359.13,"color":"#555555","italic":true,"size":12},"t12":{"id":"t12","text":"kookpunt 41 °C","x":29.21,"y":375.13,"color":"#555555","italic":true,"size":12},"t13":{"id":"t13","x":0,"y":449.9,"text":"2. Vacuümdestillatie en het nomogram","bold":true,"size":19,"color":"#1d4ed8"},"t14":{"id":"t14","x":0,"y":477.9,"text":"Sommige stoffen koken pas bij een hoge temperatuur, of ontleden eerst. Dan destilleer je onder verlaagde","size":13,"italic":true},"t15":{"id":"t15","x":0,"y":496.9,"text":"druk. Maar bij welke druk kookt je stof bij een handige temperatuur? Daarvoor heb je drie methoden:","size":13,"italic":true},"t16":{"id":"t16","x":0,"y":515.9,"text":"Clausius-Clapeyron, Antoine en het nomogram.","size":13,"italic":true},"t17":{"id":"t17","x":0,"y":544.9,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t18":{"id":"t18","x":0,"y":563.9,"text":"• Vacuümdestillatie bij een onhandig hoog kookpunt of als de stof ontleedt voor hij kookt.","size":13,"color":"#047857"},"t19":{"id":"t19","x":0,"y":582.9,"text":"• Clausius-Clapeyron (via Δ Hvap) en Antoine (via A, B, C) gebruiken gegevens van de stof zelf.","size":13,"color":"#047857"},"t20":{"id":"t20","x":0,"y":601.9,"text":"• Een nomogram gaat uit van een gemiddeld verloop en heeft een afleesfout: het minst nauwkeurig.","size":13,"color":"#047857"},"t21":{"id":"t21","x":0,"y":636.9,"text":"Tolueen afdampen bij 80 mbar (opgave 1)","size":13,"bold":false},"t22":{"id":"t22","text":"tolueen","x":68.31,"y":813.93,"color":"#555555","italic":true,"size":12},"t23":{"id":"t23","text":"kookpunt 111 °C","x":43.51,"y":829.93,"color":"#555555","italic":true,"size":12},"t24":{"id":"t24","x":0,"y":904.7,"text":"3. De rotatiefilmverdamper","bold":true,"size":19,"color":"#1d4ed8"},"t25":{"id":"t25","x":0,"y":932.7,"text":"Met een rotavap haal je een oplosmiddel weg. Dat is gewoon een eenvoudige vacuümdestillatie. Hoe kies je","size":13,"italic":true},"t26":{"id":"t26","x":0,"y":951.7,"text":"de druk en de badtemperatuur, en wanneer gaat er product mee?","size":13,"italic":true},"t27":{"id":"t27","x":0,"y":980.7,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t28":{"id":"t28","x":0,"y":999.7,"text":"• Een rotavap is een eenvoudige vacuümdestillatie.","size":13,"color":"#047857"},"t29":{"id":"t29","x":0,"y":1018.7,"text":"• Badtemperatuur onder het kookpunt bij de ingestelde druk: verdampen, niet koken, niet spatten.","size":13,"color":"#047857"},"t30":{"id":"t30","x":0,"y":1037.7,"text":"• Geschikt bij een groot verschil in vluchtigheid: α > 50.","size":13,"color":"#047857"},"t31":{"id":"t31","x":0,"y":1098.7,"text":"4. Eenvoudige destillatie: het T,x-diagram","bold":true,"size":19,"color":"#1d4ed8"},"t32":{"id":"t32","x":0,"y":1126.7,"text":"Als je een mengsel van twee vloeistoffen kookt, welke samenstelling heeft de damp dan? En wat gebeurt er","size":13,"italic":true},"t33":{"id":"t33","x":0,"y":1145.7,"text":"met de vloeistof en het destillaat terwijl je doorgaat? Het T,x-diagram laat het zien.","size":13,"italic":true},"t34":{"id":"t34","x":0,"y":1174.7,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t35":{"id":"t35","x":0,"y":1193.7,"text":"• Verticaal omhoog tot de kookcurve: daar begint het koken. Horizontaal naar de dauwcurve: daar lees je","size":13,"color":"#047857"},"t36":{"id":"t36","x":12,"y":1212.7,"text":"de damp af.","size":13,"color":"#047857"},"t37":{"id":"t37","x":0,"y":1231.7,"text":"• De damp is rijker aan de vluchtigste stof, maar niet zuiver.","size":13,"color":"#047857"},"t38":{"id":"t38","x":0,"y":1250.7,"text":"• Tijdens het destilleren loopt de temperatuur op (kooktraject) en wordt het destillaat minder zuiver:","size":13,"color":"#047857"},"t39":{"id":"t39","x":12,"y":1269.7,"text":"op tijd stoppen.","size":13,"color":"#047857"},"t40":{"id":"t40","x":0,"y":1304.7,"text":"T,x-diagram van 1-hexeen en p-xyleen (opgave 5a tot c). het mengsel van dia 11 tot 14: CCl₄ (vluchtigst)","size":13,"bold":false},"t41":{"id":"t41","x":0,"y":1323.7,"text":"en tolueen","size":13,"bold":false},"t42":{"id":"t42","text":"tetrachloormethaan","x":24,"y":1500.73,"color":"#555555","italic":true,"size":12},"t43":{"id":"t43","text":"77 °C","x":69.3,"y":1516.73,"color":"#555555","italic":true,"size":12},"t44":{"id":"t44","text":"tolueen","x":265.75,"y":1500.73,"color":"#555555","italic":true,"size":12},"t45":{"id":"t45","text":"111 °C","x":268.85,"y":1516.73,"color":"#555555","italic":true,"size":12},"t46":{"id":"t46","x":0,"y":1565.5,"text":"T,x-diagram van 1-hexeen en p-xyleen (opgave 5a tot c)","size":13,"bold":false},"t47":{"id":"t47","text":"1-hexeen","x":99.81,"y":1742.53,"color":"#555555","italic":true,"size":12},"t48":{"id":"t48","text":"337 K","x":109.11,"y":1758.53,"color":"#555555","italic":true,"size":12},"t49":{"id":"t49","text":"p-xyleen","x":349.81,"y":1742.53,"color":"#555555","italic":true,"size":12},"t50":{"id":"t50","text":"411 K","x":359.11,"y":1758.53,"color":"#555555","italic":true,"size":12},"t51":{"id":"t51","x":0,"y":1833.3,"text":"5. Relatieve vluchtigheid","bold":true,"size":19,"color":"#1d4ed8"},"t52":{"id":"t52","x":0,"y":1861.3,"text":"Hoe goed scheidt een destillatie twee stoffen? Dat hangt af van de breedte van de kooklus. Eén getal vat","size":13,"italic":true},"t53":{"id":"t53","x":0,"y":1880.3,"text":"dat samen: de relatieve vluchtigheid α. Bij een ideaal mengsel kun je α schatten uit de twee kookpunten.","size":13,"italic":true},"t54":{"id":"t54","x":0,"y":1909.3,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t55":{"id":"t55","x":0,"y":1928.3,"text":"• α = (y(1-x))/(x(1-y)); B is de vluchtigste stof.","size":13,"color":"#047857"},"t56":{"id":"t56","x":0,"y":1947.3,"text":"• Ideaal mengsel: ln α = (20,5(TA - TB))/(TA + TB), kookpunten in kelvin.","size":13,"color":"#047857"},"t57":{"id":"t57","x":0,"y":1966.3,"text":"• y = (α x)/(1+(α-1)x) geeft de beste zuiverheid van één eenvoudige destillatie.","size":13,"color":"#047857"},"t58":{"id":"t58","x":0,"y":2001.3,"text":"Water en methanol (opgave 4)","size":13,"bold":false},"t59":{"id":"t59","text":"methanol","x":33.2,"y":2098.33,"color":"#555555","italic":true,"size":12},"t60":{"id":"t60","text":"64 °C","x":42.5,"y":2114.33,"color":"#555555","italic":true,"size":12},"t61":{"id":"t61","text":"water","x":242.5,"y":2098.33,"color":"#555555","italic":true,"size":12},"t62":{"id":"t62","text":"100 °C","x":239.4,"y":2114.33,"color":"#555555","italic":true,"size":12},"t63":{"id":"t63","x":0,"y":2163.1,"text":"Chloorbenzeen en broombenzeen (dia 16)","size":13,"bold":false},"t64":{"id":"t64","text":"chloorbenzeen","x":49.71,"y":2340.13,"color":"#555555","italic":true,"size":12},"t65":{"id":"t65","text":"130 °C","x":71.41,"y":2356.13,"color":"#555555","italic":true,"size":12},"t66":{"id":"t66","text":"broombenzeen","x":262.81,"y":2340.13,"color":"#555555","italic":true,"size":12},"t67":{"id":"t67","text":"156 °C","x":281.41,"y":2356.13,"color":"#555555","italic":true,"size":12},"t68":{"id":"t68","x":0,"y":2430.9,"text":"6. Kookvertraging","bold":true,"size":19,"color":"#1d4ed8"},"t69":{"id":"t69","x":0,"y":2458.9,"text":"Soms wordt een vloeistof heter dan zijn kookpunt zonder te koken. Dan gaat hij ineens heel heftig koken.","size":13,"italic":true},"t70":{"id":"t70","x":0,"y":2477.9,"text":"Waarom gebeurt dat, en hoe voorkom je het?","size":13,"italic":true},"t71":{"id":"t71","x":0,"y":2506.9,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t72":{"id":"t72","x":0,"y":2525.9,"text":"• Kookvertraging = oververhitting door gebrek aan nucleatie.","size":13,"color":"#047857"},"t73":{"id":"t73","x":0,"y":2544.9,"text":"• Voorkomen: kooksteentjes, roeren, ruwe kolf; bij vacuüm een Claisen-opzet met capillair.","size":13,"color":"#047857"},"t74":{"id":"t74","x":0,"y":2605.9,"text":"7. Structuuropheldering","bold":true,"size":19,"color":"#1d4ed8"},"t75":{"id":"t75","x":0,"y":2633.9,"text":"Bij deze les horen twee structuurvragen met ¹H- en ¹³C-NMR. De spectroscopie zelf staat in les 2 en 5.","size":13,"italic":true},"t76":{"id":"t76","x":0,"y":2652.9,"text":"Hier staan de oplossingen kort, met de structuur erbij.","size":13,"italic":true},"t77":{"id":"t77","x":0,"y":2681.9,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t78":{"id":"t78","x":0,"y":2700.9,"text":"• DBE eerst: dat zegt hoeveel ringen en dubbele bindingen er zijn.","size":13,"color":"#047857"},"t79":{"id":"t79","x":0,"y":2719.9,"text":"• C=O van een keton rond 200 ppm; C–Cl rond 65 ppm.","size":13,"color":"#047857"},"t80":{"id":"t80","x":0,"y":2754.9,"text":"Structuur van C₆H₈O (opdracht 1). 2-cyclohexen-1-on, C₆H₈O, met nummering","size":13,"bold":false},"t81":{"id":"t81","text":".","x":24,"y":2793.93,"color":"#ffffff","size":6},"t82":{"id":"t82","text":".","x":214,"y":2973.93,"color":"#ffffff","size":6},"t83":{"id":"t83","text":"1","x":93.48,"y":2851.1,"color":"#d64545","bold":true,"size":12},"t84":{"id":"t84","text":"2","x":64.52,"y":2925.64,"color":"#d64545","bold":true,"size":12},"t85":{"id":"t85","text":"3","x":119.9,"y":2957.63,"color":"#d64545","bold":true,"size":12},"t86":{"id":"t86","text":"4","x":175.39,"y":2925.61,"color":"#d64545","bold":true,"size":12},"t87":{"id":"t87","text":"5","x":175.28,"y":2861.62,"color":"#d64545","bold":true,"size":12},"t88":{"id":"t88","text":"6","x":119.9,"y":2829.63,"color":"#d64545","bold":true,"size":12},"t89":{"id":"t89","x":0,"y":3020.3,"text":"Structuur van C₆H₈O (opdracht 1). 3-chloorhexaan, C₆H₁₃Cl, met nummering","size":13,"bold":false},"t90":{"id":"t90","text":".","x":77.89,"y":3059.33,"color":"#ffffff","size":6},"t91":{"id":"t91","text":".","x":377.89,"y":3199.33,"color":"#ffffff","size":6},"t92":{"id":"t92","text":"1","x":238.77,"y":3118.52,"color":"#d64545","bold":true,"size":12},"t93":{"id":"t93","text":"2","x":183.45,"y":3174.53,"color":"#d64545","bold":true,"size":12},"t94":{"id":"t94","text":"3","x":127.22,"y":3129.26,"color":"#d64545","bold":true,"size":12},"t95":{"id":"t95","text":"4","x":114.09,"y":3174.43,"color":"#d64545","bold":true,"size":12},"t96":{"id":"t96","text":"5","x":79.55,"y":3106.43,"color":"#d64545","bold":true,"size":12},"t9