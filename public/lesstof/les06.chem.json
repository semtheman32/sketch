":"a60","order":1,"stereo":"none"},"b55":{"id":"b55","a1":"a60","a2":"a55","order":1,"stereo":"none"},"b56":{"id":"b56","a1":"a61","a2":"a62","order":1,"stereo":"none"},"b57":{"id":"b57","a1":"a62","a2":"a63","order":1,"stereo":"none"},"b58":{"id":"b58","a1":"a63","a2":"a64","order":1,"stereo":"none"},"b59":{"id":"b59","a1":"a63","a2":"a65","order":1,"stereo":"none"},"b60":{"id":"b60","a1":"a65","a2":"a66","order":1,"stereo":"none"},"b61":{"id":"b61","a1":"a66","a2":"a67","order":1,"stereo":"none"}},"arrows":{},"curlies":{},"texts":{"t1":{"id":"t1","x":22,"y":48,"text":"Vacuüm- en eenvoudige destillatie","bold":true,"size":24},"t2":{"id":"t2","x":22,"y":78,"text":"Scheidingstechnieken. Alle tekeningen uit het lesoverzicht, met de uitleg per hoofdstuk.","size":13,"italic":true,"color":"#6b7280"},"t3":{"id":"t3","x":0,"y":142,"text":"1. Verdampen en koken: het p,T-diagram","bold":true,"size":21,"color":"#3b6fd4"},"t4":{"id":"t4","x":22,"y":210,"text":"Een vloeistof verdampt al lang voordat hij kookt. Wanneer kookt hij dan precies? En waarom kookt hij","size":13.5,"italic":true},"t5":{"id":"t5","x":22,"y":229,"text":"lager als je de druk verlaagt? Het p,T-diagram van een zuivere stof geeft het antwoord.","size":13.5,"italic":true},"t6":{"id":"t6","x":22,"y":311,"text":"• Een vloeistof kookt als verzadigde dampspanning = omgevingsdruk.","size":13.5},"t7":{"id":"t7","x":22,"y":330,"text":"• Onder het kookpunt verdampt een vloeistof wel; hij kookt alleen niet.","size":13.5},"t8":{"id":"t8","x":22,"y":349,"text":"• Lagere omgevingsdruk betekent een lager kookpunt.","size":13.5},"t9":{"id":"t9","x":22,"y":415,"text":"Refluxkoeler bij 5 °C (Lavendel vraag 20)","size":14,"bold":true},"t10":{"id":"t10","text":"dichloormethaan","x":32.11,"y":520.13,"color":"#555555","italic":true,"size":12},"t11":{"id":"t11","text":"kookpunt 41 °C","x":35.21,"y":536.13,"color":"#555555","italic":true,"size":12},"t12":{"id":"t12","x":0,"y":619.9,"text":"2. Vacuümdestillatie en het nomogram","bold":true,"size":21,"color":"#3b6fd4"},"t13":{"id":"t13","x":22,"y":687.9,"text":"Sommige stoffen koken pas bij een hoge temperatuur, of ontleden eerst. Dan destilleer je onder verlaagde","size":13.5,"italic":true},"t14":{"id":"t14","x":22,"y":706.9,"text":"druk. Maar bij welke druk kookt je stof bij een handige temperatuur? Daarvoor heb je drie methoden:","size":13.5,"italic":true},"t15":{"id":"t15","x":22,"y":725.9,"text":"Clausius-Clapeyron, Antoine en het nomogram.","size":13.5,"italic":true},"t16":{"id":"t16","x":22,"y":807.9,"text":"• Vacuümdestillatie bij een onhandig hoog kookpunt of als de stof ontleedt voor hij kookt.","size":13.5},"t17":{"id":"t17","x":22,"y":826.9,"text":"• Clausius-Clapeyron (via Δ Hvap) en Antoine (via A, B, C) gebruiken gegevens van de stof zelf.","size":13.5},"t18":{"id":"t18","x":22,"y":845.9,"text":"• Een nomogram gaat uit van een gemiddeld verloop en heeft een afleesfout: het minst nauwkeurig.","size":13.5},"t19":{"id":"t19","x":22,"y":911.9,"text":"Tolueen afdampen bij 80 mbar (opgave 1)","size":14,"bold":true},"t20":{"id":"t20","text":"tolueen","x":74.31,"y":1076.93,"color":"#555555","italic":true,"size":12},"t21":{"id":"t21","text":"kookpunt 111 °C","x":49.51,"y":1092.93,"color":"#555555","italic":true,"size":12},"t22":{"id":"t22","x":0,"y":1176.7,"text":"3. De rotatiefilmverdamper","bold":true,"size":21,"color":"#3b6fd4"},"t23":{"id":"t23","x":22,"y":1244.7,"text":"Met een rotavap haal je een oplosmiddel weg. Dat is gewoon een eenvoudige vacuümdestillatie. Hoe kies je","size":13.5,"italic":true},"t24":{"id":"t24","x":22,"y":1263.7,"text":"de druk en de badtemperatuur, en wanneer gaat er product mee?","size":13.5,"italic":true},"t25":{"id":"t25","x":22,"y":1345.7,"text":"• Een rotavap is een eenvoudige vacuümdestillatie.","size":13.5},"t26":{"id":"t26","x":22,"y":1364.7,"text":"• Badtemperatuur onder het kookpunt bij de ingestelde druk: verdampen, niet koken, niet spatten.","size":13.5},"t27":{"id":"t27","x":22,"y":1383.7,"text":"• Geschikt bij een groot verschil in vluchtigheid: α > 50.","size":13.5},"t28":{"id":"t28","x":0,"y":1457.7,"text":"4. Eenvoudige destillatie: het T,x-diagram","bold":true,"size":21,"color":"#3b6fd4"},"t29":{"id":"t29","x":22,"y":1525.7,"text":"Als je een mengsel van twee vloeistoffen kookt, welke samenstelling heeft de damp dan? En wat gebeurt er","size":13.5,"italic":true},"t30":{"id":"t30","x":22,"y":1544.7,"text":"met de vloeistof en het destillaat terwijl je doorgaat? Het T,x-diagram laat het zien.","size":13.5,"italic":true},"t31":{"id":"t31","x":22,"y":1626.7,"text":"• Verticaal omhoog tot de kookcurve: daar begint het koken. Horizontaal naar de dauwcurve: daar lees je","size":13.5},"t32":{"id":"t32","x":36,"y":1645.7,"text":"de damp af.","size":13.5},"t33":{"id":"t33","x":22,"y":1664.7,"text":"• De damp is rijker aan de vluchtigste stof, maar niet zuiver.","size":13.5},"t34":{"id":"t34","x":22,"y":1683.7,"text":"• Tijdens het destilleren loopt de temperatuur op (kooktraject) en wordt het destillaat minder zuiver:","size":13.5},"t35":{"id":"t35","x":36,"y":1702.7,"text":"op tijd stoppen.","size":13.5},"t36":{"id":"t36","x":22,"y":1768.7,"text":"T,x-diagram van 1-hexeen en p-xyleen (opgave 5a tot c). het mengsel van dia 11 tot 14: CCl₄ (vluchtigst)","size":14,"bold":true},"t37":{"id":"t37","x":22,"y":1787.7,"text":"en tolueen","size":14,"bold":true},"t38":{"id":"t38","text":"tetrachloormethaan","x":30,"y":1952.73,"color":"#555555","italic":true,"size":12},"t39":{"id":"t39","text":"77 °C","x":75.3,"y":1968.73,"color":"#555555","italic":true,"size":12},"t40":{"id":"t40","text":"tolueen","x":271.75,"y":1952.73,"color":"#555555","italic":true,"size":12},"t41":{"id":"t41","text":"111 °C","x":274.85,"y":1968.73,"color":"#555555","italic":true,"size":12},"t42":{"id":"t42","x":22,"y":2044.5,"text":"T,x-diagram van 1-hexeen en p-xyleen (opgave 5a tot c)","size":14,"bold":true},"t43":{"id":"t43","text":"1-hexeen","x":105.81,"y":2209.53,"color":"#555555","italic":true,"size":12},"t44":{"id":"t44","text":"337 K","x":115.11,"y":2225.53,"color":"#555555","italic":true,"size":12},"t45":{"id":"t45","text":"p-xyleen","x":355.81,"y":2209.53,"color":"#555555","italic":true,"size":12},"t46":{"id":"t46","text":"411 K","x":365.11,"y":2225.53,"color":"#555555","italic":true,"size":12},"t47":{"id":"t47","x":0,"y":2309.3,"text":"5. Relatieve vluchtigheid","bold":true,"size":21,"color":"#3b6fd4"},"t48":{"id":"t48","x":22,"y":2377.3,"text":"Hoe goed scheidt een destillatie twee stoffen? Dat hangt af van de breedte van de kooklus. Eén getal vat","size":13.5,"italic":true},"t49":{"id":"t49","x":22,"y":2396.3,"text":"dat samen: de relatieve vluchtigheid α. Bij een ideaal mengsel kun je α schatten uit de twee kookpunten.","size":13.5,"italic":true},"t50":{"id":"t50","x":22,"y":2478.3,"text":"• α = (y(1-x))/(x(1-y)); B is de vluchtigste stof.","size":13.5},"t51":{"id":"t51","x":22,"y":2497.3,"text":"• Ideaal mengsel: ln α = (20,5(TA - TB))/(TA + TB), kookpunten in kelvin.","size":13.5},"t52":{"id":"t52","x":22,"y":2516.3,"text":"• y = (α x)/(1+(α-1)x) geeft de beste zuiverheid van één eenvoudige destillatie.","size":13.5},"t53":{"id":"t53","x":22,"y":2582.3,"text":"Water en methanol (opgave 4)","size":14,"bold":true},"t54":{"id":"t54","text":"methanol","x":39.2,"y":2667.33,"color":"#555555","italic":true,"size":12},"t55":{"id":"t55","text":"64 °C","x":48.5,"y":2683.33,"color":"#555555","italic":true,"size":12},"t56":{"id":"t56","text":"water","x":248.5,"y":2667.33,"color":"#555555","italic":true,"size":12},"t57":{"id":"t57","text":"100 °C","x":245.4,"y":2683.33,"color":"#555555","italic":true,"size":12},"t58":{"id":"t58","x":22,"y":2759.1,"text":"Chloorbenzeen en broombenzeen (dia 16)","size":14,"bold":true},"t59":{"id":"t59","text":"chloorbenzeen","x":55.71,"y":2924.13,"color":"#555555","italic":true,"size":12},"t60":{"id":"t60","text":"130 °C","x":77.41,"y":2940.13,"color":"#555555","italic":true,"size":12},"t61":{"id":"t61","text":"broombenzeen","x":268.81,"y":2924.13,"color":"#555555","italic":true,"size":12},"t62":{"id":"t62","text":"156 °C","x":287.41,"y":2940.13,"color":"#555555","italic":true,"size":12},"t63":{"id":"t63","x":0,"y":3023.9,"text":"6. Kookvertraging","bold":true,"size":21,"color":"#3b6fd4"},"t64":{"id":"t64","x":22,"y":3091.9,"text":"Soms wordt een vloeistof heter dan zijn kookpunt zonder te koken. Dan gaat hij ineens heel heftig koken.","size":13.5,"italic":true},"t65":{"id":"t65","x":22,"y":3110.9,"text":"Waarom gebeurt dat, en hoe voorkom je het?","size":13.5,"italic":true},"t66":{"id":"t66","x":22,"y":3192.9,"text":"• Kookvertraging = oververhitting door gebrek aan nucleatie.","size":13.5},"t67":{"id":"t67","x":22,"y":3211.9,"text":"• Voorkomen: kooksteentjes, roeren, ruwe kolf; bij vacuüm een Claisen-opzet met capillair.","size":13.5},"t68":{"id":"t68","x":0,"y":3285.9,"text":"7. Structuuropheldering","bold":true,"size":21,"color":"#3b6fd4"},"t69":{"id":"t69","x":22,"y":3353.9,"text":"Bij deze les horen twee structuurvragen met ¹H- en ¹³C-NMR. De spectroscopie zelf staat in les 2 en 5.","size":13.5,"italic":true},"t70":{"id":"t70","x":22,"y":3372.9,"text":"Hier staan de oplossingen kort, met de structuur erbij.","size":13.5,"italic":true},"t71":{"id":"t71","x":22,"y":3454.9,"text":"• DBE eerst: dat zegt hoeveel ringen en dubbele bindingen er zijn.","size":13.5},"t72":{"id":"t72","x":22,"y":3473.9,"text":"• C=O van een keton rond 200 ppm; C–Cl rond 65 ppm.","size":13.5},"t73":{"id":"t73","x":22,"y":3539.9,"text":"Structuur van C₆H₈O (opdracht 1). 2-cyclohexen-1-on, C₆H₈O, met nummering","size":14,"bold":true},"t74":{"id":"t74","text":".","x":30,"y":3566.93,"color":"#ffffff","size":6},"t75":{"id":"t75","text":".","x":220,"y":3746.93,"color":"#ffffff","size":6},"t76":{"id":"t76","text":"1","x":99.48,"y":3624.1,"color":"#d64545","bold":true,"size":12},"t77":{"id":"t77","text":"2","x":70.52,"y":3698.64,"color":"#d64545","bold":true,"size":12},"t78":{"id":"t78","text":"3","x":125.9,"y":3730.