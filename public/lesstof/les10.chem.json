"a1":"a11","a2":"a12","order":1,"stereo":"none"},"b9":{"id":"b9","a1":"a12","a2":"a13","order":1,"stereo":"none"},"b10":{"id":"b10","a1":"a12","a2":"a14","order":1,"stereo":"none"},"b11":{"id":"b11","a1":"a15","a2":"a16","order":1,"stereo":"none"},"b12":{"id":"b12","a1":"a16","a2":"a17","order":1,"stereo":"none"},"b13":{"id":"b13","a1":"a16","a2":"a18","order":2,"stereo":"none"},"b14":{"id":"b14","a1":"a20","a2":"a21","order":1,"stereo":"none"},"b15":{"id":"b15","a1":"a21","a2":"a22","order":2,"stereo":"none"},"b16":{"id":"b16","a1":"a21","a2":"a23","order":1,"stereo":"none"},"b17":{"id":"b17","a1":"a25","a2":"a26","order":1,"stereo":"none"},"b18":{"id":"b18","a1":"a26","a2":"a27","order":1,"stereo":"none"},"b19":{"id":"b19","a1":"a28","a2":"a29","order":1,"stereo":"none"},"b20":{"id":"b20","a1":"a29","a2":"a30","order":2,"stereo":"none"},"b21":{"id":"b21","a1":"a29","a2":"a31","order":1,"stereo":"none"},"b22":{"id":"b22","a1":"a31","a2":"a32","order":1,"stereo":"none"},"b23":{"id":"b23","a1":"a33","a2":"a34","order":1,"stereo":"none"},"b24":{"id":"b24","a1":"a34","a2":"a35","order":1,"stereo":"none"},"b25":{"id":"b25","a1":"a34","a2":"a36","order":1,"stereo":"none"},"b26":{"id":"b26","a1":"a34","a2":"a37","order":1,"stereo":"none"}},"arrows":{},"curlies":{},"texts":{"t1":{"id":"t1","x":22,"y":48,"text":"Gefractioneerde en azeotropische destillatie","bold":true,"size":24},"t2":{"id":"t2","x":22,"y":78,"text":"Scheidingstechnieken. Alle tekeningen uit het lesoverzicht, met de uitleg per hoofdstuk.","size":13,"italic":true,"color":"#6b7280"},"t3":{"id":"t3","x":0,"y":142,"text":"1. Herhaalde destillatie","bold":true,"size":21,"color":"#3b6fd4"},"t4":{"id":"t4","x":22,"y":210,"text":"Na één eenvoudige destillatie is je product vaak nog niet zuiver genoeg. Wat gebeurt er als je het","size":13.5,"italic":true},"t5":{"id":"t5","x":22,"y":229,"text":"destillaat nog een keer destilleert? En waarom is dat geen goede werkwijze?","size":13.5,"italic":true},"t6":{"id":"t6","x":22,"y":311,"text":"• Elke extra destillatie is een trede: horizontaal naar de dauwcurve, omlaag naar de kookcurve.","size":13.5},"t7":{"id":"t7","x":22,"y":330,"text":"• Herhalen werkt, maar is traag en kost opbrengst (hold-up).","size":13.5},"t8":{"id":"t8","x":22,"y":349,"text":"• Beter: een kolom met schotels.","size":13.5},"t9":{"id":"t9","x":22,"y":415,"text":"Methanol en water nog een keer destilleren (opgave 1a, 1b)","size":14,"bold":true},"t10":{"id":"t10","text":"methanol","x":39.2,"y":500,"color":"#555555","italic":true,"size":12},"t11":{"id":"t11","text":"64 °C","x":48.5,"y":516,"color":"#555555","italic":true,"size":12},"t12":{"id":"t12","text":"water","x":248.5,"y":500,"color":"#555555","italic":true,"size":12},"t13":{"id":"t13","text":"100 °C","x":245.4,"y":516,"color":"#555555","italic":true,"size":12},"t14":{"id":"t14","x":0,"y":599.8,"text":"2. Gefractioneerde destillatie en schotels","bold":true,"size":21,"color":"#3b6fd4"},"t15":{"id":"t15","x":22,"y":667.8,"text":"Een destillatiekolom doet hetzelfde als een paar destillaties achter elkaar, maar in één keer. Hoe werkt","size":13.5,"italic":true},"t16":{"id":"t16","x":22,"y":686.8,"text":"dat in de kolom? En hoe druk je uit hoe goed een kolom scheidt?","size":13.5,"italic":true},"t17":{"id":"t17","x":22,"y":768.8,"text":"• In de kolom gebeurt herhaald condenseren en verdampen: de vluchtigste stof komt bovenin.","size":13.5},"t18":{"id":"t18","x":22,"y":787.8,"text":"• Scheidend vermogen in theoretische schotels: Vigreux 7 tot 12 cm, pakking 1 tot 5 cm per schotel.","size":13.5},"t19":{"id":"t19","x":22,"y":806.8,"text":"• Te snel destilleren kost zuiverheid.","size":13.5},"t20":{"id":"t20","x":0,"y":880.8,"text":"3. Hoeveel schotels? Fenske en traptreden","bold":true,"size":21,"color":"#3b6fd4"},"t21":{"id":"t21","x":22,"y":948.8,"text":"Hoe lang moet je kolom zijn? Dat hangt af van waar je begint, waar je heen wilt en hoe goed de stoffen","size":13.5,"italic":true},"t22":{"id":"t22","x":22,"y":967.8,"text":"zich laten scheiden. Je kunt het uitrekenen met Fenske of aftellen in het diagram.","size":13.5,"italic":true},"t23":{"id":"t23","x":22,"y":1049.8,"text":"• N = (ln ((1-x₀)/(x₀)·(xD)/(1-xD)))/(ln α) - 1: een minimum.","size":13.5},"t24":{"id":"t24","x":22,"y":1068.8,"text":"• Grafisch: treden − 1 = aantal schotels.","size":13.5},"t25":{"id":"t25","x":22,"y":1087.8,"text":"• Kleine α of hoge xD: veel schotels.","size":13.5},"t26":{"id":"t26","x":0,"y":1161.8,"text":"4. Niet-ideale mengsels en azeotropen","bold":true,"size":21,"color":"#3b6fd4"},"t27":{"id":"t27","x":22,"y":1229.8,"text":"Veel mengsels zijn niet ideaal: bij het mengen wordt het warmer of kouder. Dan kan de kooklus op één punt","size":13.5,"italic":true},"t28":{"id":"t28","x":22,"y":1248.8,"text":"samengeknepen zijn. Daar heeft de damp dezelfde samenstelling als de vloeistof, en houdt destilleren op","size":13.5,"italic":true},"t29":{"id":"t29","x":22,"y":1267.8,"text":"met scheiden.","size":13.5,"italic":true},"t30":{"id":"t30","x":22,"y":1349.8,"text":"• Azeotroop: x = y, kookt als een zuivere stof, niet te scheiden door destillatie.","size":13.5},"t31":{"id":"t31","x":22,"y":1368.8,"text":"• Minimum (endotherm mengen): destillaat = azeotroop, residu = zuivere stof aan jouw kant.","size":13.5},"t32":{"id":"t32","x":22,"y":1387.8,"text":"• Maximum (exotherm mengen): destillaat = zuivere stof aan jouw kant, residu = azeotroop.","size":13.5},"t33":{"id":"t33","x":22,"y":1453.8,"text":"Chloroform en aceton (opgave 2). water en 1,4-dioxaan: de minimumazeotroop van dia 15 tot 18","size":14,"bold":true},"t34":{"id":"t34","text":"water","x":30,"y":1618.8,"color":"#555555","italic":true,"size":12},"t35":{"id":"t35","text":"1,4-dioxaan","x":201.4,"y":1618.8,"color":"#555555","italic":true,"size":12},"t36":{"id":"t36","text":"C₄H₈O₂","x":216.9,"y":1634.8,"color":"#555555","italic":true,"size":12},"t37":{"id":"t37","x":22,"y":1710.6,"text":"Chloroform en aceton (opgave 2)","size":14,"bold":true},"t38":{"id":"t38","text":"chloroform","x":47.61,"y":1855.7,"color":"#555555","italic":true,"size":12},"t39":{"id":"t39","text":"aceton","x":260.01,"y":1855.7,"color":"#555555","italic":true,"size":12},"t40":{"id":"t40","x":22,"y":1931.5,"text":"Water en salpeterzuur (opgave 3)","size":14,"bold":true},"t41":{"id":"t41","text":"water","x":30,"y":2076.52,"color":"#555555","italic":true,"size":12},"t42":{"id":"t42","text":"salpeterzuur","x":198.25,"y":2076.52,"color":"#555555","italic":true,"size":12},"t43":{"id":"t43","x":0,"y":2160.3,"text":"5. Voorbij de azeotroop","bold":true,"size":21,"color":"#3b6fd4"},"t44":{"id":"t44","x":22,"y":2228.3,"text":"Met een minimumazeotroop is je destillaat op zijn best de azeotroop. Water en ethanol stoppen bij","size":13.5,"italic":true},"t45":{"id":"t45","x":22,"y":2247.3,"text":"ongeveer 96 massa% ethanol. Hoe kom je toch aan iets zuiverders?","size":13.5,"italic":true},"t46":{"id":"t46","x":22,"y":2329.3,"text":"• Destillatie komt niet voorbij een (minimum)azeotroop.","size":13.5},"t47":{"id":"t47","x":22,"y":2348.3,"text":"• Drie uitwegen: andere techniek (droogmiddel, moleculaire zeef), andere druk, extra stof (tolueen).","size":13.5},"t48":{"id":"t48","x":22,"y":2414.3,"text":"water en ethanol: minimumazeotroop bij 95,6 massa% ethanol, 78,2 °C","size":14,"bold":true},"t49":{"id":"t49","text":"water","x":30,"y":2519.36,"color":"#555555","italic":true,"size":12},"t50":{"id":"t50","text":"ethanol","x":213.8,"y":2519.36,"color":"#555555","italic":true,"size":12},"t51":{"id":"t51","x":0,"y":2603.2,"text":"6. Structuuropheldering","bold":true,"size":21,"color":"#3b6fd4"},"t52":{"id":"t52","x":22,"y":2671.2,"text":"Bij deze les horen twee structuurvragen met MS, ¹H- en ¹³C-NMR. Hier staan de oplossingen kort. Het","size":13.5,"italic":true},"t53":{"id":"t53","x":22,"y":2690.2,"text":"massaspectrum is afgelezen uit de figuren van de opdracht.","size":13.5,"italic":true},"t54":{"id":"t54","x":22,"y":2772.2,"text":"• Cl: pieken op M en M + 2 in de verhouding 3 : 1.","size":13.5},"t55":{"id":"t55","x":22,"y":2791.2,"text":"• Eén singulet van 9H: een tert-butylgroep.","size":13.5},"t56":{"id":"t56","x":22,"y":2857.2,"text":"2-butanon, C₄H₈O, met nummering","size":14,"bold":true},"t57":{"id":"t57","text":".","x":50.22,"y":2884.16,"color":"#ffffff","size":6},"t58":{"id":"t58","text":".","x":280.22,"y":3024.16,"color":"#ffffff","size":6},"t59":{"id":"t59","text":"1","x":175.52,"y":2990.03,"color":"#d64545","bold":true,"size":12},"t60":{"id":"t60","text":"2","x":122.09,"y":2975.13,"color":"#d64545","bold":true,"size":12},"t61":{"id":"t61","text":"3","x":85.58,"y":3002.16,"color":"#d64545","bold":true,"size":12},"t62":{"id":"t62","text":"4","x":30,"y":2946.32,"color":"#d64545","bold":true,"size":12},"t63":{"id":"t63","x":22,"y":3097.6,"text":"Welke stoffen zijn het? (opdracht 1 en 2). 2-chloor-2-methylpropaan, C₄H₉Cl","size":14,"bold":true},"t64":{"id":"t64","text":".","x":30,"y":3124.56,"color":"#ffffff","size":6},"t65":{"id":"t65","text":".","x":190,"y":3284.56,"color":"#ffffff","size":6}},"brackets":{"k1":{"id":"k1","x1":0,"y1":0,"x2":820,"y2":94,"shape":"box","label":"OSY2 · Les 10","color":"#7b4fc9"},"k2":{"id":"k2","x1":0,"y1":166,"x2":820,"y2":245,"shape":"box","label":"Waarom","color":"#3b6fd4"},"k3":{"id":"k3","x1":0,"y1":267,"x2":820,"y2":365,"shape":"box","label":"Onthoud","color":"#2e9e5b"},"k4":{"id":"k4","x1":0,"y1":387,"x2":820,"y2":541.8,"shape":"box","label":""},"k5":{"id":"k5","x1":0,"y1":623.8,"x2":820,"y2":702.8,"shape":"box","label":"Waarom","color":"#3b6fd4"},"k6":{"id":"k6","x1":0,"y1":724.8,"x2":820,"y2":822.8,"shape":"box","label":"Onthoud","color":"#2e9e5b"},"k7":{"id":"k7","x1":0,"y1":904.8,"x2":820,"y2":983.8,"shape":"box","label":"Waarom","color":"#3b6fd4"},"k8":{"id":"k8","x1":0,"y1":1005.8,"x2":820,"y2":1103.8,"shape":"box","label":"Onthoud","color":"#2e9e5b"},"k9":{"id":"k9","x1":0,"y1":1185.8,"x2":820,"y2":1283.8,"shape":"box","label":"Waarom","color":"#3b6fd4"},"k10":{"id":"k