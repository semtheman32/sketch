"a1":"a11","a2":"a12","order":1,"stereo":"none"},"b9":{"id":"b9","a1":"a12","a2":"a13","order":1,"stereo":"none"},"b10":{"id":"b10","a1":"a12","a2":"a14","order":1,"stereo":"none"},"b11":{"id":"b11","a1":"a15","a2":"a16","order":1,"stereo":"none"},"b12":{"id":"b12","a1":"a16","a2":"a17","order":1,"stereo":"none"},"b13":{"id":"b13","a1":"a16","a2":"a18","order":2,"stereo":"none"},"b14":{"id":"b14","a1":"a20","a2":"a21","order":1,"stereo":"none"},"b15":{"id":"b15","a1":"a21","a2":"a22","order":2,"stereo":"none"},"b16":{"id":"b16","a1":"a21","a2":"a23","order":1,"stereo":"none"},"b17":{"id":"b17","a1":"a25","a2":"a26","order":1,"stereo":"none"},"b18":{"id":"b18","a1":"a26","a2":"a27","order":1,"stereo":"none"},"b19":{"id":"b19","a1":"a28","a2":"a29","order":1,"stereo":"none"},"b20":{"id":"b20","a1":"a29","a2":"a30","order":2,"stereo":"none"},"b21":{"id":"b21","a1":"a29","a2":"a31","order":1,"stereo":"none"},"b22":{"id":"b22","a1":"a31","a2":"a32","order":1,"stereo":"none"},"b23":{"id":"b23","a1":"a33","a2":"a34","order":1,"stereo":"none"},"b24":{"id":"b24","a1":"a34","a2":"a35","order":1,"stereo":"none"},"b25":{"id":"b25","a1":"a34","a2":"a36","order":1,"stereo":"none"},"b26":{"id":"b26","a1":"a34","a2":"a37","order":1,"stereo":"none"}},"arrows":{},"curlies":{},"texts":{"t1":{"id":"t1","x":0,"y":0,"text":"Les 10 · Gefractioneerde en azeotropische destillatie","bold":true,"size":24},"t2":{"id":"t2","x":0,"y":30,"text":"Scheidingstechnieken. Lesstof uit het lesoverzicht: tekeningen met uitleg per hoofdstuk.","size":13,"italic":true,"color":"#6b7280"},"t3":{"id":"t3","x":0,"y":74,"text":"1. Herhaalde destillatie","bold":true,"size":19,"color":"#1d4ed8"},"t4":{"id":"t4","x":0,"y":102,"text":"Na één eenvoudige destillatie is je product vaak nog niet zuiver genoeg. Wat gebeurt er als je het","size":13,"italic":true},"t5":{"id":"t5","x":0,"y":121,"text":"destillaat nog een keer destilleert? En waarom is dat geen goede werkwijze?","size":13,"italic":true},"t6":{"id":"t6","x":0,"y":150,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t7":{"id":"t7","x":0,"y":169,"text":"• Elke extra destillatie is een trede: horizontaal naar de dauwcurve, omlaag naar de kookcurve.","size":13,"color":"#047857"},"t8":{"id":"t8","x":0,"y":188,"text":"• Herhalen werkt, maar is traag en kost opbrengst (hold-up).","size":13,"color":"#047857"},"t9":{"id":"t9","x":0,"y":207,"text":"• Beter: een kolom met schotels.","size":13,"color":"#047857"},"t10":{"id":"t10","x":0,"y":242,"text":"Methanol en water nog een keer destilleren (opgave 1a, 1b)","size":13,"bold":false},"t11":{"id":"t11","text":"methanol","x":33.2,"y":339,"color":"#555555","italic":true,"size":12},"t12":{"id":"t12","text":"64 °C","x":42.5,"y":355,"color":"#555555","italic":true,"size":12},"t13":{"id":"t13","text":"water","x":242.5,"y":339,"color":"#555555","italic":true,"size":12},"t14":{"id":"t14","text":"100 °C","x":239.4,"y":355,"color":"#555555","italic":true,"size":12},"t15":{"id":"t15","x":0,"y":429.8,"text":"2. Gefractioneerde destillatie en schotels","bold":true,"size":19,"color":"#1d4ed8"},"t16":{"id":"t16","x":0,"y":457.8,"text":"Een destillatiekolom doet hetzelfde als een paar destillaties achter elkaar, maar in één keer. Hoe werkt","size":13,"italic":true},"t17":{"id":"t17","x":0,"y":476.8,"text":"dat in de kolom? En hoe druk je uit hoe goed een kolom scheidt?","size":13,"italic":true},"t18":{"id":"t18","x":0,"y":505.8,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t19":{"id":"t19","x":0,"y":524.8,"text":"• In de kolom gebeurt herhaald condenseren en verdampen: de vluchtigste stof komt bovenin.","size":13,"color":"#047857"},"t20":{"id":"t20","x":0,"y":543.8,"text":"• Scheidend vermogen in theoretische schotels: Vigreux 7 tot 12 cm, pakking 1 tot 5 cm per schotel.","size":13,"color":"#047857"},"t21":{"id":"t21","x":0,"y":562.8,"text":"• Te snel destilleren kost zuiverheid.","size":13,"color":"#047857"},"t22":{"id":"t22","x":0,"y":623.8,"text":"3. Hoeveel schotels? Fenske en traptreden","bold":true,"size":19,"color":"#1d4ed8"},"t23":{"id":"t23","x":0,"y":651.8,"text":"Hoe lang moet je kolom zijn? Dat hangt af van waar je begint, waar je heen wilt en hoe goed de stoffen","size":13,"italic":true},"t24":{"id":"t24","x":0,"y":670.8,"text":"zich laten scheiden. Je kunt het uitrekenen met Fenske of aftellen in het diagram.","size":13,"italic":true},"t25":{"id":"t25","x":0,"y":699.8,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t26":{"id":"t26","x":0,"y":718.8,"text":"• N = (ln ((1-x₀)/(x₀)·(xD)/(1-xD)))/(ln α) - 1: een minimum.","size":13,"color":"#047857"},"t27":{"id":"t27","x":0,"y":737.8,"text":"• Grafisch: treden − 1 = aantal schotels.","size":13,"color":"#047857"},"t28":{"id":"t28","x":0,"y":756.8,"text":"• Kleine α of hoge xD: veel schotels.","size":13,"color":"#047857"},"t29":{"id":"t29","x":0,"y":817.8,"text":"4. Niet-ideale mengsels en azeotropen","bold":true,"size":19,"color":"#1d4ed8"},"t30":{"id":"t30","x":0,"y":845.8,"text":"Veel mengsels zijn niet ideaal: bij het mengen wordt het warmer of kouder. Dan kan de kooklus op één punt","size":13,"italic":true},"t31":{"id":"t31","x":0,"y":864.8,"text":"samengeknepen zijn. Daar heeft de damp dezelfde samenstelling als de vloeistof, en houdt destilleren op","size":13,"italic":true},"t32":{"id":"t32","x":0,"y":883.8,"text":"met scheiden.","size":13,"italic":true},"t33":{"id":"t33","x":0,"y":912.8,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t34":{"id":"t34","x":0,"y":931.8,"text":"• Azeotroop: x = y, kookt als een zuivere stof, niet te scheiden door destillatie.","size":13,"color":"#047857"},"t35":{"id":"t35","x":0,"y":950.8,"text":"• Minimum (endotherm mengen): destillaat = azeotroop, residu = zuivere stof aan jouw kant.","size":13,"color":"#047857"},"t36":{"id":"t36","x":0,"y":969.8,"text":"• Maximum (exotherm mengen): destillaat = zuivere stof aan jouw kant, residu = azeotroop.","size":13,"color":"#047857"},"t37":{"id":"t37","x":0,"y":1004.8,"text":"Chloroform en aceton (opgave 2). water en 1,4-dioxaan: de minimumazeotroop van dia 15 tot 18","size":13,"bold":false},"t38":{"id":"t38","text":"water","x":24,"y":1181.8,"color":"#555555","italic":true,"size":12},"t39":{"id":"t39","text":"1,4-dioxaan","x":195.4,"y":1181.8,"color":"#555555","italic":true,"size":12},"t40":{"id":"t40","text":"C₄H₈O₂","x":210.9,"y":1197.8,"color":"#555555","italic":true,"size":12},"t41":{"id":"t41","x":0,"y":1246.6,"text":"Chloroform en aceton (opgave 2)","size":13,"bold":false},"t42":{"id":"t42","text":"chloroform","x":41.61,"y":1403.7,"color":"#555555","italic":true,"size":12},"t43":{"id":"t43","text":"aceton","x":254.01,"y":1403.7,"color":"#555555","italic":true,"size":12},"t44":{"id":"t44","x":0,"y":1452.5,"text":"Water en salpeterzuur (opgave 3)","size":13,"bold":false},"t45":{"id":"t45","text":"water","x":24,"y":1609.52,"color":"#555555","italic":true,"size":12},"t46":{"id":"t46","text":"salpeterzuur","x":192.25,"y":1609.52,"color":"#555555","italic":true,"size":12},"t47":{"id":"t47","x":0,"y":1684.3,"text":"5. Voorbij de azeotroop","bold":true,"size":19,"color":"#1d4ed8"},"t48":{"id":"t48","x":0,"y":1712.3,"text":"Met een minimumazeotroop is je destillaat op zijn best de azeotroop. Water en ethanol stoppen bij","size":13,"italic":true},"t49":{"id":"t49","x":0,"y":1731.3,"text":"ongeveer 96 massa% ethanol. Hoe kom je toch aan iets zuiverders?","size":13,"italic":true},"t50":{"id":"t50","x":0,"y":1760.3,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t51":{"id":"t51","x":0,"y":1779.3,"text":"• Destillatie komt niet voorbij een (minimum)azeotroop.","size":13,"color":"#047857"},"t52":{"id":"t52","x":0,"y":1798.3,"text":"• Drie uitwegen: andere techniek (droogmiddel, moleculaire zeef), andere druk, extra stof (tolueen).","size":13,"color":"#047857"},"t53":{"id":"t53","x":0,"y":1833.3,"text":"water en ethanol: minimumazeotroop bij 95,6 massa% ethanol, 78,2 °C","size":13,"bold":false},"t54":{"id":"t54","text":"water","x":24,"y":1950.36,"color":"#555555","italic":true,"size":12},"t55":{"id":"t55","text":"ethanol","x":207.8,"y":1950.36,"color":"#555555","italic":true,"size":12},"t56":{"id":"t56","x":0,"y":2025.2,"text":"6. Structuuropheldering","bold":true,"size":19,"color":"#1d4ed8"},"t57":{"id":"t57","x":0,"y":2053.2,"text":"Bij deze les horen twee structuurvragen met MS, ¹H- en ¹³C-NMR. Hier staan de oplossingen kort. Het","size":13,"italic":true},"t58":{"id":"t58","x":0,"y":2072.2,"text":"massaspectrum is afgelezen uit de figuren van de opdracht.","size":13,"italic":true},"t59":{"id":"t59","x":0,"y":2101.2,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t60":{"id":"t60","x":0,"y":2120.2,"text":"• Cl: pieken op M en M + 2 in de verhouding 3 : 1.","size":13,"color":"#047857"},"t61":{"id":"t61","x":0,"y":2139.2,"text":"• Eén singulet van 9H: een tert-butylgroep.","size":13,"color":"#047857"},"t62":{"id":"t62","x":0,"y":2174.2,"text":"2-butanon, C₄H₈O, met nummering","size":13,"bold":false},"t63":{"id":"t63","text":".","x":44.22,"y":2213.16,"color":"#ffffff","size":6},"t64":{"id":"t64","text":".","x":274.22,"y":2353.16,"color":"#ffffff","size":6},"t65":{"id":"t65","text":"1","x":169.52,"y":2319.03,"color":"#d64545","bold":true,"size":12},"t66":{"id":"t66","text":"2","x":116.09,"y":2304.13,"color":"#d64545","bold":true,"size":12},"t67":{"id":"t67","text":"3","x":79.58,"y":2331.16,"color":"#d64545","bold":true,"size":12},"t68":{"id":"t68","text":"4","x":24,"y":2275.32,"color":"#d64545","bold":true,"size":12},"t69":{"id":"t69","x":0,"y":2399.6,"text":"Welke stoffen zijn het? (opdracht 1 en 2). 2-chloor-2-methylpropaan, C₄H₉Cl","size":13,"bold":false},"t70":{"id":"t70","text":".","x":24,"y":2438.56,"color":"#ffffff","size":6},"t71":{"id":"t71","text":".","x":184,"y":2598.56,"color":"#ffffff","size":6}},"brackets":{}}