:"b23","to":"a31","half":true,"bend":-1},"c5":{"id":"c5","from":"b30","to":"a42","half":false,"bend":-1},"c6":{"id":"c6","from":"a51","to":"b36","half":true,"bend":1},"c7":{"id":"c7","from":"b34","to":"b36","half":true,"bend":-1},"c8":{"id":"c8","from":"b34","to":"a48","half":true,"bend":1},"c9":{"id":"c9","from":"b49","to":"a67","half":false,"bend":-1},"c10":{"id":"c10","from":"a85","to":"b64","half":true,"bend":-1},"c11":{"id":"c11","from":"b62","to":"b64","half":true,"bend":1},"c12":{"id":"c12","from":"b62","to":"a82","half":true,"bend":1}},"texts":{"t1":{"id":"t1","x":0,"y":0,"text":"Les 9 · Massaspectrometrie: fragmenten, isotopen en brutoformule","bold":true,"size":24},"t2":{"id":"t2","x":0,"y":30,"text":"Structuuropheldering. Lesstof uit het lesoverzicht: tekeningen met uitleg per hoofdstuk.","size":13,"italic":true,"color":"#6b7280"},"t3":{"id":"t3","x":0,"y":74,"text":"1. Wat is een massaspectrum?","bold":true,"size":19,"color":"#1d4ed8"},"t4":{"id":"t4","x":0,"y":102,"text":"Een massaspectrometer schiet elektronen op een molecuul. Het molecuul wordt een ion en valt in stukken.","size":13,"italic":true},"t5":{"id":"t5","x":0,"y":121,"text":"Het spectrum laat zien hoe zwaar die stukken zijn. Welke piek is het hele molecuul, en wat zijn de andere","size":13,"italic":true},"t6":{"id":"t6","x":0,"y":140,"text":"pieken?","size":13,"italic":true},"t7":{"id":"t7","x":0,"y":169,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t8":{"id":"t8","x":0,"y":188,"text":"• M + e⁻ → M⁺• + 2 e⁻: het molecuulion is een radicaalkation.","size":13,"color":"#047857"},"t9":{"id":"t9","x":0,"y":207,"text":"• Je ziet alleen positieve deeltjes. Neutrale stukken zie je alleen als massaverlies.","size":13,"color":"#047857"},"t10":{"id":"t10","x":0,"y":226,"text":"• Molecuulion = hoogste m/z. Basispiek = hoogste piek (100 %).","size":13,"color":"#047857"},"t11":{"id":"t11","x":0,"y":261,"text":"Ionisatie van methaan. Methaan wordt een radicaalkation, m/z 16","size":13,"bold":false},"t12":{"id":"t12","text":".","x":28,"y":300,"color":"#ffffff","size":6},"t13":{"id":"t13","text":".","x":398,"y":400,"color":"#ffffff","size":6},"t14":{"id":"t14","text":"methaan","x":43,"y":417,"color":"#555555","italic":true,"size":12},"t15":{"id":"t15","text":"radicaalkation, m/z 16","x":228,"y":417,"color":"#555555","italic":true,"size":12},"t16":{"id":"t16","x":0,"y":453.8,"text":"Waarom: Een elektron uit een binding of een vrij elektronenpaar wordt eruit geslagen. Dan blijft er één","size":13,"italic":true,"color":"#6b7280"},"t17":{"id":"t17","x":0,"y":472.8,"text":"elektron alleen achter: een radicaal. Er is ook één elektron te weinig voor een neutraal molecuul: een","size":13,"italic":true,"color":"#6b7280"},"t18":{"id":"t18","x":0,"y":491.8,"text":"plus-lading. Die combinatie is instabiel. Daarom breekt het ion vaak verder. Alleen geladen deeltjes kun","size":13,"italic":true,"color":"#6b7280"},"t19":{"id":"t19","x":0,"y":510.8,"text":"je met een elektrisch of magnetisch veld sturen, dus alleen die worden gemeten.","size":13,"italic":true,"color":"#6b7280"},"t20":{"id":"t20","x":0,"y":581.8,"text":"2. Fragmentatie van alkanen","bold":true,"size":19,"color":"#1d4ed8"},"t21":{"id":"t21","x":0,"y":609.8,"text":"Een alkaan kan op veel plekken breken. Toch zijn sommige pieken hoog en andere laag. Welke binding breekt","size":13,"italic":true},"t22":{"id":"t22","x":0,"y":628.8,"text":"het liefst, en waarom?","size":13,"italic":true},"t23":{"id":"t23","x":0,"y":657.8,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t24":{"id":"t24","x":0,"y":676.8,"text":"• Alkanen breken bij een C–C-binding: kation (gezien) + radicaal (niet gezien).","size":13,"color":"#047857"},"t25":{"id":"t25","x":0,"y":695.8,"text":"• Massaverlies 15, 29, 43, 57 = methyl, ethyl, propyl, butyl.","size":13,"color":"#047857"},"t26":{"id":"t26","x":0,"y":714.8,"text":"• De binding breekt waar het stabielste kation ontstaat. Bij een vertakking dus vaak.","size":13,"color":"#047857"},"t27":{"id":"t27","x":0,"y":749.8,"text":"Hexaan breekt tussen C2 en C3. Links en rechts dezelfde atoomposities: alleen de binding tussen C2 en C3","size":13,"bold":false},"t28":{"id":"t28","x":0,"y":768.8,"text":"is weg","size":13,"bold":false},"t29":{"id":"t29","text":"hexaan, M⁺• m/z 86","x":74.45,"y":915.39,"color":"#555555","italic":true,"size":12},"t30":{"id":"t30","text":"m/z 57: butylkation","x":449.18,"y":921.39,"color":"#d64545","bold":true,"size":12},"t31":{"id":"t31","text":"+ ethylradicaal (niet gezien)","x":274.76,"y":939.39,"color":"#555555","italic":true,"size":12},"t32":{"id":"t32","x":0,"y":976.2,"text":"Waarom: Bij het breken krijgt één stuk de lading. Een primair kation met een groter radicaal is gunstiger","size":13,"italic":true,"color":"#6b7280"},"t33":{"id":"t33","x":0,"y":995.2,"text":"dan CH₃⁺ of een CH₃•. Daarom zie je bij hexaan veel 57 en 43, en weinig 71 en 15 (dia 11). Bij een","size":13,"italic":true,"color":"#6b7280"},"t34":{"id":"t34","x":0,"y":1014.2,"text":"vertakking kan een secundair of tertiair kation ontstaan. Die breuk gaat nog makkelijker.","size":13,"italic":true,"color":"#6b7280"},"t35":{"id":"t35","x":0,"y":1085.2,"text":"3. Isotopen: M+1 en M+2","bold":true,"size":19,"color":"#1d4ed8"},"t36":{"id":"t36","x":0,"y":1113.2,"text":"Vlak naast het molecuulion zie je vaak nog een kleine of juist hoge piek. Die komt van zwaardere","size":13,"italic":true},"t37":{"id":"t37","x":0,"y":1132.2,"text":"isotopen. Chloor en broom herken je er direct aan.","size":13,"italic":true},"t38":{"id":"t38","x":0,"y":1161.2,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t39":{"id":"t39","x":0,"y":1180.2,"text":"• Cl: M+2 ≈ ⅓ van M (3 : 1). Br: M+2 ≈ M (1 : 1).","size":13,"color":"#047857"},"t40":{"id":"t40","x":0,"y":1199.2,"text":"• M+1 is klein: ¹³C, ongeveer 1,1 % per C-atoom.","size":13,"color":"#047857"},"t41":{"id":"t41","x":0,"y":1218.2,"text":"• Een fragment met Cl of Br heeft hetzelfde patroon. Een fragment zonder halogeen niet.","size":13,"color":"#047857"},"t42":{"id":"t42","x":0,"y":1279.2,"text":"4. Halogeenalkanen: twee manieren van breken","bold":true,"size":19,"color":"#1d4ed8"},"t43":{"id":"t43","x":0,"y":1307.2,"text":"Een broomalkaan en een chlooralkaan breken op een verschillende manier. Bij broom breekt bijna altijd de","size":13,"italic":true},"t44":{"id":"t44","x":0,"y":1326.2,"text":"C–Br-binding. Bij chloor zie je ook een tweede soort splitsing: α-splitsing. Hoe werken die twee, en","size":13,"italic":true},"t45":{"id":"t45","x":0,"y":1345.2,"text":"wanneer gebeurt welke?","size":13,"italic":true},"t46":{"id":"t46","x":0,"y":1374.2,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t47":{"id":"t47","x":0,"y":1393.2,"text":"• Heterolytisch: C–X breekt, beide elektronen naar X. Er blijft een carbokation over. Hele pijl.","size":13,"color":"#047857"},"t48":{"id":"t48","x":0,"y":1412.2,"text":"• α-splitsing: C–C naast C–X breekt homolytisch. Er ontstaat C=X⁺. Halve pijlen.","size":13,"color":"#047857"},"t49":{"id":"t49","x":0,"y":1431.2,"text":"• Broom: vooral heterolytisch (M − 79). Chloor: heterolytisch én α-splitsing.","size":13,"color":"#047857"},"t50":{"id":"t50","x":0,"y":1466.2,"text":"1-Broompropaan: heterolytische splitsing. Hele pijl: het bindingspaar gaat naar Br. Er blijven CH₃CH₂CH₂⁺","size":13,"bold":false},"t51":{"id":"t51","x":0,"y":1485.2,"text":"en Br• over","size":13,"bold":false},"t52":{"id":"t52","text":"m/z 122 en 124","x":46.29,"y":1609.19,"color":"#555555","italic":true,"size":12},"t53":{"id":"t53","text":"m/z 43","x":362.58,"y":1609.19,"color":"#d64545","bold":true,"size":12},"t54":{"id":"t54","text":"+ Br• (neutraal)","x":236.06,"y":1627.19,"color":"#555555","italic":true,"size":12},"t55":{"id":"t55","x":0,"y":1664,"text":"Waarom: Br is elektronegatiever dan C. Breekt de C–Br-binding, dan gaan beide elektronen naar Br. Het","size":13,"italic":true,"color":"#6b7280"},"t56":{"id":"t56","x":0,"y":1683,"text":"C-atoom houdt geen elektron van die binding over en wordt C⁺. Omdat de C–Br-binding zwak is, gaat dit","size":13,"italic":true,"color":"#6b7280"},"t57":{"id":"t57","x":0,"y":1702,"text":"veel makkelijker dan het breken van een C–C-binding.","size":13,"italic":true,"color":"#6b7280"},"t58":{"id":"t58","x":0,"y":1747,"text":"α-splitsing. Drie halve pijlen: één elektron van Cl en één uit de C–CH₃-binding vormen samen de","size":13,"bold":false},"t59":{"id":"t59","x":0,"y":1766,"text":"C=Cl⁺-binding; het andere elektron gaat met CH₃ mee.","size":13,"bold":false},"t60":{"id":"t60","text":"m/z 78 en 80","x":35.22,"y":1930.16,"color":"#555555","italic":true,"size":12},"t61":{"id":"t61","text":"m/z 63 en 65","x":263.04,"y":1930.16,"color":"#d64545","bold":true,"size":12},"t62":{"id":"t62","x":0,"y":1979,"text":"Heterolytisch. Eén hele pijl: het bindingspaar van C–Cl gaat naar Cl, zodat het isopropylkation (m/z 43)","size":13,"bold":false},"t63":{"id":"t63","x":0,"y":1998,"text":"en Cl• overblijven.","size":13,"bold":false},"t64":{"id":"t64","text":"m/z 78 en 80","x":35.22,"y":2172.06,"color":"#555555","italic":true,"size":12},"t65":{"id":"t65","text":"m/z 43 (basispiek)","x":255.82,"y":2202.06,"color":"#d64545","bold":true,"size":12},"t66":{"id":"t66","x":0,"y":2276.9,"text":"5. Ethers, alcoholen en α-splitsing","bold":true,"size":19,"color":"#1d4ed8"},"t67":{"id":"t67","x":0,"y":2304.9,"text":"Zit er een O in het molecuul, dan zijn er weer twee manieren van breken. De C–O-binding breekt","size":13,"italic":true},"t68":{"id":"t68","x":0,"y":2323.9,"text":"heterolytisch, of de C–C-binding naast O breekt (α-splitsing). Bij alcoholen gaat ook vaak water af.","size":13,"italic":true},"t69":{"id":"t69","x":0,"y":2352.9,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t70":{"id":"t70","x":0,"y":2371.9,"text":"• Ether: C–O heterolytisch → carbokation. C–C naast O (α) → oxoniumion.","size":13,"color":"#047857"},"t71":{"id":"t71","x":0,"y":2390.9,"text":"• Alcohol: α-splitsing (m/z 45 bij een 2-ol, 31 bij een primaire alcohol) en M − 18 (water).","size":13,"color":"#047857"},"t72":{"id":"t72","x":0,"y":2409.9,"text":"• Het grootste of stabielste radicaal vertrekt het liefst.","size":13,"color":"#047857"},"t73":{"id":"t73","x":0,"y":2444.9,"text":"Ether: α-splitsing (sec-butylisopropylether). Drie halve pijlen: er ontstaat een C=O⁺-binding","size":13,"bold":false},"t74":{"id":"t74","x":0,"y":2463.9,"text":"(oxoniumion) en een ethylradicaal","size":13,"bold":false},"t75":{"id":"t75","text":"M⁺• m/z 116","x":55.63,"y":2735.73,"color":"#555555","italic":true,"size":12},"t76":{"id":"t76","text":"m/z 87","x":333.5,"y":2735.73,"color":"#d64545","bold":true,"size":12},"t77":{"id":"t77","text":"+ ethylradicaal","x":388.38,"y":2753.73,"color":"#555555","italic":true,"size":12},"t78":{"id":"t78","x":0,"y":2790.5,"text":"Waarom: Bij α-splitsing gaat er een C–C-binding kapot, maar O deelt een extra elektronenpaar met C. Het","size":13,"italic":true,"color":"#6b7280"},"t79":{"id":"t79","x":0,"y":2809.5,"text":"oxoniumion heeft dan op elk atoom een octet. Dat is stabiel. Bij heterolytische splitsing trekt het","size":13,"italic":true,"color":"#6b7280"},"t80":{"id":"t80","x":0,"y":2828.5,"text":"elektronegatieve O het bindingspaar naar zich toe. Het carbokation dat overblijft is secundair: ook","size":13,"italic":true,"color":"#6b7280"},"t81":{"id":"t81","x":0,"y":2847.5,"text":"redelijk stabiel.","size":13,"italic":true,"color":"#6b7280"},"t82":{"id":"t82","x":0,"y":2892.5,"text":"Alcohol: α-splitsing van 2-hexanol. Heterolytische splitsing van C–O: sec-butylkation (m/z 57) en een","size":13,"bold":false},"t83":{"id":"t83","x":0,"y":2911.5,"text":"isopropoxyradicaal (dia 21)","size":13,"bold":false},"t84":{"id":"t84","text":"M⁺• m/z 116","x":55.63,"y":3186.63,"color":"#555555","italic":true,"size":12},"t85":{"id":"t85","text":"m/z 57","x":370.93,"y":3186.63,"color":"#d64545","bold":true,"size":12},"t86":{"id":"t86","text":"+ isopropoxyradicaal","x":269.1,"y":3204.63,"color":"#555555","italic":true,"size":12},"t87":{"id":"t87","x":0,"y":3241.4,"text":"Waarom: Het butylradicaal is groter en stabieler dan het methylradicaal. Daarom is 45 veel hoger dan 87.","size":13,"italic":true,"color":"#6b7280"},"t88":{"id":"t88","x":0,"y":3260.4,"text":"Het ion CH₃CH=OH⁺ is een geprotoneerde C=O: alle atomen hebben een octet.","size":13,"italic":true,"color":"#6b7280"},"t89":{"id":"t89","x":0,"y":3305.4,"text":"Alcohol: α-splitsing van 2-hexanol. Verlies van water (M − 18): de H van het γ-koolstofatoom gaat met de","size":13,"bold":false},"t90":{"id":"t90","x":0,"y":3324.4,"text":"OH mee als H₂O (dia 25)","size":13,"bold":false},"t91":{"id":"t91","text":"M⁺• m/z 102","x":90.31,"y":3477.16,"color":"#555555","italic":true,"size":12},"t92":{"id":"t92","text":"m/z 45 (basispiek)","x":475.1,"y":3507.16,"color":"#d64545","bold":true,"size":12},"t93":{"id":"t93","text":"+ butylradicaal","x":356.61,"y":3495.16,"color":"#555555","italic":true,"size":12},"t94":{"id":"t94","x":0,"y":3544,"text":"Waarom: Het butylradicaal is groter en stabieler dan het methylradicaal. Daarom is 45 veel hoger dan 87.","size":13,"italic":true,"color":"#6b7280"},"t95":{"id":"t95","x":0,"y":3563,"text":"Het ion CH₃CH=OH⁺ is een geprotoneerde C=O: alle atomen hebben een octet.","size":13,"italic":true,"color":"#6b7280"},"t96":{"id":"t96","x":0,"y":3608,"text":"Een ether met M = 116 (antwoord 14-7). Verlies van water (M − 18): de H van het γ-koolstofatoom gaat met","size":13,"bold":false},"t97":{"id":"t97","x":0,"y":3627,"text":"de OH mee als H₂O (dia 25)","size":13,"bold":false},"t98":{"id":"t98","text":"α","x":200.53,"y":3718,"color":"#d64545","bold":true,"size":12},"t99":{"id":"t99","text":"β","x":165.93,"y":3738,"color":"#d64545","bold":true,"size":12},"t100":{"id":"t100","text":"γ","x":131.33,"y":3718.1,"color":"#d64545","bold":true,"size":12},"t101":{"id":"t101","text":"M⁺• m/z 102","x":86.31,"y":3776.2,"color":"#555555","italic":true,"size":12},"t102":{"id":"t102","text":"m/z 84 (M − 18)","x":434.43,"y":3800.2,"color":"#d64545","bold":true,"size":12},"t103":{"id":"t103","x":0,"y":3849,"text":"58 = M − 42. Dit is de McLafferty-omlegging. Die komt in les 12.","size":13,"bold":false},"t104":{"id":"t104","text":"m/z 100","x":128.03,"y":4008.94,"color":"#d64545","bold":true,"size":12},"t105":{"id":"t105","text":"m/z 85","x":368.03,"y":4008.94,"color":"#d64545","bold":true,"size":12},"t106":{"id":"t106","text":"m/z 43","x":538.03,"y":4008.94,"color":"#d64545","bold":true,"size":12},"t107":{"id":"t107","text":"m/z 58","x":683.03,"y":4008.94,"color":"#d64545","bold":true,"size":12},"t108":{"id":"t108","x":0,"y":4083.7,"text":"6. Brutoformule: 13-regel, stikstofregel en DBE","bold":true,"size":19,"color":"#1d4ed8"},"t109":{"id":"t109","x":0,"y":4111.7,"text":"Met het molecuulion weet je de massa. Hoe kom je daarmee aan een brutoformule? En hoeveel ringen en","size":13,"italic":true},"t110":{"id":"t110","x":0,"y":4130.7,"text":"dubbele bindingen zitten erin?","size":13,"italic":true},"t111":{"id":"t111","x":0,"y":4159.7,"text":"Onthoud","bold":true,"size":13,"color":"#047857"},"t112":{"id":"t112","x":0,"y":4178.7,"text":"• 13-regel: M/13 = n rest r → CₙHₙ₊ᵣ. Eerst de massa van O, N, Cl enzovoort aftrekken.","size":13,"color":"#047857"},"t113":{"id":"t113","x":0,"y":4197.7,"text":"• Stikstofregel: M oneven → oneven aantal N.","size":13,"color":"#047857"},"t114":{"id":"t114","x":0,"y":4216.7,"text":"• DBE: I = C - H/2 + N/2 - X/2 + 1. I ≥ 4: denk aan een benzeenring.","size":13,"color":"#047857"},"t115":{"id":"t115","x":0,"y":4251.7,"text":"Antwoord: o-Chlooraniline (2-chlooraniline)","size":13,"bold":false},"t116":{"id":"t116","text":".","x":24,"y":4290.74,"color":"#ffffff","size":6},"t117":{"id":"t117","text":".","x":188,"y":4430.74,"color":"#ffffff","size":6},"t118":{"id":"t118","x":0,"y":4477.1,"text":"Antwoord: trans-2-Butenal (crotonaldehyde)","size":13,"bold":false},"t119":{"id":"t119","text":".","x":24,"y":4516.14,"color":"#ffffff","size":6},"t12