id":"c4","from":"b23","to":"a31","half":true,"bend":-1},"c5":{"id":"c5","from":"b30","to":"a42","half":false,"bend":-1},"c6":{"id":"c6","from":"a51","to":"b36","half":true,"bend":1},"c7":{"id":"c7","from":"b34","to":"b36","half":true,"bend":-1},"c8":{"id":"c8","from":"b34","to":"a48","half":true,"bend":1},"c9":{"id":"c9","from":"b49","to":"a67","half":false,"bend":-1},"c10":{"id":"c10","from":"a85","to":"b64","half":true,"bend":-1},"c11":{"id":"c11","from":"b62","to":"b64","half":true,"bend":1},"c12":{"id":"c12","from":"b62","to":"a82","half":true,"bend":1}},"texts":{"t1":{"id":"t1","x":22,"y":48,"text":"Massaspectrometrie: fragmenten, isotopen en brutoformule","bold":true,"size":24},"t2":{"id":"t2","x":22,"y":78,"text":"Structuuropheldering. Alle tekeningen uit het lesoverzicht, met de uitleg per hoofdstuk.","size":13,"italic":true,"color":"#6b7280"},"t3":{"id":"t3","x":0,"y":142,"text":"1. Wat is een massaspectrum?","bold":true,"size":21,"color":"#3b6fd4"},"t4":{"id":"t4","x":22,"y":210,"text":"Een massaspectrometer schiet elektronen op een molecuul. Het molecuul wordt een ion en valt in stukken.","size":13.5,"italic":true},"t5":{"id":"t5","x":22,"y":229,"text":"Het spectrum laat zien hoe zwaar die stukken zijn. Welke piek is het hele molecuul, en wat zijn de andere","size":13.5,"italic":true},"t6":{"id":"t6","x":22,"y":248,"text":"pieken?","size":13.5,"italic":true},"t7":{"id":"t7","x":22,"y":330,"text":"• M + e⁻ → M⁺• + 2 e⁻: het molecuulion is een radicaalkation.","size":13.5},"t8":{"id":"t8","x":22,"y":349,"text":"• Je ziet alleen positieve deeltjes. Neutrale stukken zie je alleen als massaverlies.","size":13.5},"t9":{"id":"t9","x":22,"y":368,"text":"• Molecuulion = hoogste m/z. Basispiek = hoogste piek (100 %).","size":13.5},"t10":{"id":"t10","x":22,"y":434,"text":"Ionisatie van methaan. Methaan wordt een radicaalkation, m/z 16","size":14,"bold":true},"t11":{"id":"t11","text":".","x":34,"y":461,"color":"#ffffff","size":6},"t12":{"id":"t12","text":".","x":404,"y":561,"color":"#ffffff","size":6},"t13":{"id":"t13","text":"methaan","x":49,"y":578,"color":"#555555","italic":true,"size":12},"t14":{"id":"t14","text":"radicaalkation, m/z 16","x":234,"y":578,"color":"#555555","italic":true,"size":12},"t15":{"id":"t15","x":22,"y":610.8,"text":"Waarom: Een elektron uit een binding of een vrij elektronenpaar wordt eruit geslagen. Dan blijft er één","size":13,"italic":true,"color":"#6b7280"},"t16":{"id":"t16","x":22,"y":629.8,"text":"elektron alleen achter: een radicaal. Er is ook één elektron te weinig voor een neutraal molecuul: een","size":13,"italic":true,"color":"#6b7280"},"t17":{"id":"t17","x":22,"y":648.8,"text":"plus-lading. Die combinatie is instabiel. Daarom breekt het ion vaak verder. Alleen geladen deeltjes kun","size":13,"italic":true,"color":"#6b7280"},"t18":{"id":"t18","x":22,"y":667.8,"text":"je met een elektrisch of magnetisch veld sturen, dus alleen die worden gemeten.","size":13,"italic":true,"color":"#6b7280"},"t19":{"id":"t19","x":0,"y":741.8,"text":"2. Fragmentatie van alkanen","bold":true,"size":21,"color":"#3b6fd4"},"t20":{"id":"t20","x":22,"y":809.8,"text":"Een alkaan kan op veel plekken breken. Toch zijn sommige pieken hoog en andere laag. Welke binding breekt","size":13.5,"italic":true},"t21":{"id":"t21","x":22,"y":828.8,"text":"het liefst, en waarom?","size":13.5,"italic":true},"t22":{"id":"t22","x":22,"y":910.8,"text":"• Alkanen breken bij een C–C-binding: kation (gezien) + radicaal (niet gezien).","size":13.5},"t23":{"id":"t23","x":22,"y":929.8,"text":"• Massaverlies 15, 29, 43, 57 = methyl, ethyl, propyl, butyl.","size":13.5},"t24":{"id":"t24","x":22,"y":948.8,"text":"• De binding breekt waar het stabielste kation ontstaat. Bij een vertakking dus vaak.","size":13.5},"t25":{"id":"t25","x":22,"y":1014.8,"text":"Hexaan breekt tussen C2 en C3. Links en rechts dezelfde atoomposities: alleen de binding tussen C2 en C3","size":14,"bold":true},"t26":{"id":"t26","x":22,"y":1033.8,"text":"is weg","size":14,"bold":true},"t27":{"id":"t27","text":"hexaan, M⁺• m/z 86","x":80.45,"y":1168.39,"color":"#555555","italic":true,"size":12},"t28":{"id":"t28","text":"m/z 57: butylkation","x":455.18,"y":1174.39,"color":"#d64545","bold":true,"size":12},"t29":{"id":"t29","text":"+ ethylradicaal (niet gezien)","x":280.76,"y":1192.39,"color":"#555555","italic":true,"size":12},"t30":{"id":"t30","x":22,"y":1225.2,"text":"Waarom: Bij het breken krijgt één stuk de lading. Een primair kation met een groter radicaal is gunstiger","size":13,"italic":true,"color":"#6b7280"},"t31":{"id":"t31","x":22,"y":1244.2,"text":"dan CH₃⁺ of een CH₃•. Daarom zie je bij hexaan veel 57 en 43, en weinig 71 en 15 (dia 11). Bij een","size":13,"italic":true,"color":"#6b7280"},"t32":{"id":"t32","x":22,"y":1263.2,"text":"vertakking kan een secundair of tertiair kation ontstaan. Die breuk gaat nog makkelijker.","size":13,"italic":true,"color":"#6b7280"},"t33":{"id":"t33","x":0,"y":1337.2,"text":"3. Isotopen: M+1 en M+2","bold":true,"size":21,"color":"#3b6fd4"},"t34":{"id":"t34","x":22,"y":1405.2,"text":"Vlak naast het molecuulion zie je vaak nog een kleine of juist hoge piek. Die komt van zwaardere","size":13.5,"italic":true},"t35":{"id":"t35","x":22,"y":1424.2,"text":"isotopen. Chloor en broom herken je er direct aan.","size":13.5,"italic":true},"t36":{"id":"t36","x":22,"y":1506.2,"text":"• Cl: M+2 ≈ ⅓ van M (3 : 1). Br: M+2 ≈ M (1 : 1).","size":13.5},"t37":{"id":"t37","x":22,"y":1525.2,"text":"• M+1 is klein: ¹³C, ongeveer 1,1 % per C-atoom.","size":13.5},"t38":{"id":"t38","x":22,"y":1544.2,"text":"• Een fragment met Cl of Br heeft hetzelfde patroon. Een fragment zonder halogeen niet.","size":13.5},"t39":{"id":"t39","x":0,"y":1618.2,"text":"4. Halogeenalkanen: twee manieren van breken","bold":true,"size":21,"color":"#3b6fd4"},"t40":{"id":"t40","x":22,"y":1686.2,"text":"Een broomalkaan en een chlooralkaan breken op een verschillende manier. Bij broom breekt bijna altijd de","size":13.5,"italic":true},"t41":{"id":"t41","x":22,"y":1705.2,"text":"C–Br-binding. Bij chloor zie je ook een tweede soort splitsing: α-splitsing. Hoe werken die twee, en","size":13.5,"italic":true},"t42":{"id":"t42","x":22,"y":1724.2,"text":"wanneer gebeurt welke?","size":13.5,"italic":true},"t43":{"id":"t43","x":22,"y":1806.2,"text":"• Heterolytisch: C–X breekt, beide elektronen naar X. Er blijft een carbokation over. Hele pijl.","size":13.5},"t44":{"id":"t44","x":22,"y":1825.2,"text":"• α-splitsing: C–C naast C–X breekt homolytisch. Er ontstaat C=X⁺. Halve pijlen.","size":13.5},"t45":{"id":"t45","x":22,"y":1844.2,"text":"• Broom: vooral heterolytisch (M − 79). Chloor: heterolytisch én α-splitsing.","size":13.5},"t46":{"id":"t46","x":22,"y":1910.2,"text":"1-Broompropaan: heterolytische splitsing. Hele pijl: het bindingspaar gaat naar Br. Er blijven CH₃CH₂CH₂⁺","size":14,"bold":true},"t47":{"id":"t47","x":22,"y":1929.2,"text":"en Br• over","size":14,"bold":true},"t48":{"id":"t48","text":"m/z 122 en 124","x":52.29,"y":2041.19,"color":"#555555","italic":true,"size":12},"t49":{"id":"t49","text":"m/z 43","x":368.58,"y":2041.19,"color":"#d64545","bold":true,"size":12},"t50":{"id":"t50","text":"+ Br• (neutraal)","x":242.06,"y":2059.19,"color":"#555555","italic":true,"size":12},"t51":{"id":"t51","x":22,"y":2092,"text":"Waarom: Br is elektronegatiever dan C. Breekt de C–Br-binding, dan gaan beide elektronen naar Br. Het","size":13,"italic":true,"color":"#6b7280"},"t52":{"id":"t52","x":22,"y":2111,"text":"C-atoom houdt geen elektron van die binding over en wordt C⁺. Omdat de C–Br-binding zwak is, gaat dit","size":13,"italic":true,"color":"#6b7280"},"t53":{"id":"t53","x":22,"y":2130,"text":"veel makkelijker dan het breken van een C–C-binding.","size":13,"italic":true,"color":"#6b7280"},"t54":{"id":"t54","x":22,"y":2196,"text":"α-splitsing. Drie halve pijlen: één elektron van Cl en één uit de C–CH₃-binding vormen samen de","size":14,"bold":true},"t55":{"id":"t55","x":22,"y":2215,"text":"C=Cl⁺-binding; het andere elektron gaat met CH₃ mee.","size":14,"bold":true},"t56":{"id":"t56","text":"m/z 78 en 80","x":41.22,"y":2367.16,"color":"#555555","italic":true,"size":12},"t57":{"id":"t57","text":"m/z 63 en 65","x":269.04,"y":2367.16,"color":"#d64545","bold":true,"size":12},"t58":{"id":"t58","x":22,"y":2443,"text":"Heterolytisch. Eén hele pijl: het bindingspaar van C–Cl gaat naar Cl, zodat het isopropylkation (m/z 43)","size":14,"bold":true},"t59":{"id":"t59","x":22,"y":2462,"text":"en Cl• overblijven.","size":14,"bold":true},"t60":{"id":"t60","text":"m/z 78 en 80","x":41.22,"y":2624.06,"color":"#555555","italic":true,"size":12},"t61":{"id":"t61","text":"m/z 43 (basispiek)","x":261.82,"y":2654.06,"color":"#d64545","bold":true,"size":12},"t62":{"id":"t62","x":0,"y":2737.9,"text":"5. Ethers, alcoholen en α-splitsing","bold":true,"size":21,"color":"#3b6fd4"},"t63":{"id":"t63","x":22,"y":2805.9,"text":"Zit er een O in het molecuul, dan zijn er weer twee manieren van breken. De C–O-binding breekt","size":13.5,"italic":true},"t64":{"id":"t64","x":22,"y":2824.9,"text":"heterolytisch, of de C–C-binding naast O breekt (α-splitsing). Bij alcoholen gaat ook vaak water af.","size":13.5,"italic":true},"t65":{"id":"t65","x":22,"y":2906.9,"text":"• Ether: C–O heterolytisch → carbokation. C–C naast O (α) → oxoniumion.","size":13.5},"t66":{"id":"t66","x":22,"y":2925.9,"text":"• Alcohol: α-splitsing (m/z 45 bij een 2-ol, 31 bij een primaire alcohol) en M − 18 (water).","size":13.5},"t67":{"id":"t67","x":22,"y":2944.9,"text":"• Het grootste of stabielste radicaal vertrekt het liefst.","size":13.5},"t68":{"id":"t68","x":22,"y":3010.9,"text":"Ether: α-splitsing (sec-butylisopropylether). Drie halve pijlen: er ontstaat een C=O⁺-binding","size":14,"bold":true},"t69":{"id":"t69","x":22,"y":3029.9,"text":"(oxoniumion) en een ethylradicaal","size":14,"bold":true},"t70":{"id":"t70","text":"M⁺• m/z 116","x":61.63,"y":3289.73,"color":"#555555","italic":true,"size":12},"t71":{"id":"t71","text":"m/z 87","x":339.5,"y":